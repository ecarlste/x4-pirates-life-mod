<?xml version="1.0" encoding="utf-8"?>
<!-- Capture order for wingmen in a capture operation (md/apirateslife_capture.xml gives it).
     Fights the target with vanilla's attack script, but decides itself when to fire, so the target
     stays inside vanilla's bail gates instead of dying:
       break:    hull at or above $holdhull (default 75, vanilla's bail gate): fire
       suppress: hull below $holdhull: fire only while the target's shields hold more than
                 $burst, about 1.5 s of this wingman's laser damage, so shots still in flight land
                 on shields, not hull, whatever the weapon (heavy, slow guns get a bigger margin).
                 Fire again once shields are $shieldresume percent above that.
       floor:    hull at or below $floorhull: no fire at all
     Missiles: vanilla's attack script fires them (torpedoes too) from the first pass, and one
     already in flight kills a fighter at the hold line, as the game tests showed. So the pilot
     carries $APiratesLife_NoMissiles while this order runs, which our patch on
     aiscripts/fight.attack.object.fighter.xml reads. (Setting the missile ammo aside instead
     didn't work: vanilla still chose missile passes, with the lasers off.)
     A hand-written combat loop (shoot_at plus our own movement) was tried instead and never landed
     a shot in the game tests. See docs/specs/capture-operation.md. -->
<aiscript name="order.apirateslife.capture" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd" version="1">
  <order id="APiratesLife_Capture" name="{1774100, 101}" description="{1774100, 102}" category="internal" allowinloop="false">
    <params>
      <param name="target" required="true" type="object" text="{1041, 10126}" comment="Ship to capture">
        <input_param name="class" value="[class.ship]"/>
      </param>
      <param name="holdhull" default="75" type="internal" comment="Below this hull percentage, fire only at shields (75 is vanilla's bail gate)"/>
      <param name="floorhull" default="35" type="internal" comment="Hull percentage at or below which nobody fires"/>
      <param name="burstseconds" default="1.5" type="internal" comment="While suppressing, stop firing while the target's shields still hold this many seconds of our laser damage"/>
      <param name="shieldresume" default="10" type="internal" comment="While suppressing, fire again once shields are this many percent above the stop point"/>
      <param name="debugchance" type="internal" default="0" comment="Print debug output: 0 or 100"/>
    </params>
    <requires>
      <match shiptype="shiptype.lasertower" negate="true"/>
      <match class="class.spacesuit" negate="true"/>
    </requires>
  </order>
  <interrupts>
    <!-- Stop firing on the damage that crosses a line. Hull and shield damage events, not
         event_object_attacked, which the game tests showed fires only now and then. -->
    <handler>
      <conditions>
        <check_any>
          <event_object_hull_damaged object="$target"/>
          <event_object_shield_damaged object="$target"/>
        </check_any>
        <check_value value="$firing"/>
        <check_value value="not $target.isoperational or ($target.hullpercentage lt $holdhull and (($target.hullpercentage le $floorhull) or (not $target.maxshield) or ($target.shield le $burst)))"/>
      </conditions>
      <actions>
        <debug_text text="'[apirateslife] capture order: %s holds on %s: hull %s%%, shields %s%% (%s, stop at %s)'.[this.assignedcontrolled.knownname, event.name, @$target.hullpercentage, @$target.shieldpercentage, @$target.shield, $burst]" chance="$debugchance"/>
        <set_value name="$firing" exact="false"/>
        <abort_called_scripts resume="decide"/>
      </actions>
    </handler>
    <!-- The operation ended (abandoned, called off...): stop at once, even mid-attack -->
    <handler>
      <conditions>
        <event_object_signalled object="this.assignedcontrolled" param="'apirateslife_capture_end'"/>
        <check_value value="event.param2 == $target"/>
      </conditions>
      <actions>
        <set_value name="$firing" exact="false"/>
        <set_value name="$ended" exact="true"/>
        <abort_called_scripts resume="finish"/>
      </actions>
    </handler>
  </interrupts>
  <init>
    <set_command command="command.attackobject" param="$target"/>
    <set_value name="$firing" exact="false"/>
    <set_value name="$ended" exact="false"/>
    <set_value name="$burst" exact="0"/>
  </init>
  <attention min="unknown">
    <actions>
      <!-- No missiles (see the top of this file) -->
      <set_value name="this.$APiratesLife_NoMissiles" exact="true"/>
      <!-- The target turns hostile to the player now that this order is running, so we may fire:
           player-owned ships won't attack a ship they aren't hostile to (see
           md/apirateslife_capture.xml, Operation) -->
      <do_if value="not this.assignedcontrolled.mayattack.{$target}">
        <set_relation_boost object="$target" faction="faction.player" value="-1" decay="1" delay="600s"/>
      </do_if>

      <label name="decide"/>
      <set_value name="$firing" exact="false"/>
      <!-- The operation is over (or the prize is taken or lost) -->
      <do_if value="$ended or not @$target.isoperational or $target.isplayerowned or $target.trueowner == faction.ownerless or not @global.$APiratesLife_CaptureOps.{$target}">
        <resume label="finish"/>
      </do_if>

      <!-- Follow the target into another sector -->
      <do_if value="this.sector != $target.sector">
        <run_script name="'move.generic'" result="$movesuccess">
          <param name="destination" value="$target"/>
          <param name="debugchance" value="$debugchance"/>
        </run_script>
        <do_if value="not $movesuccess">
          <resume label="finish"/>
        </do_if>
        <resume label="decide"/>
      </do_if>

      <!-- What may still land after we stop: about $burstseconds of our laser fire, in hitpoints.
           Recomputed each time, as weapons can be lost in the fight. -->
      <set_value name="$burst" exact="this.assignedcontrolled.dps.lasers.all * $burstseconds"/>

      <!-- Break: fire until the hull is below the hold line -->
      <do_if value="$target.hullpercentage ge $holdhull">
        <set_value name="$fire" exact="true"/>
      </do_if>
      <!-- Floor: never below it -->
      <do_elseif value="$target.hullpercentage le $floorhull">
        <set_value name="$fire" exact="false"/>
      </do_elseif>
      <!-- Suppress: knock shields down once they've regenerated enough, stopping (in the hit
           handler) while they still hold our burst. A heavily armed wingman may leave shields above
           the 20% gate; the player or a lighter wingman takes them the rest of the way. -->
      <do_else>
        <set_value name="$fire" exact="$target.maxshield and $target.shield ge $burst + $target.maxshield * $shieldresume / 100.0"/>
      </do_else>

      <debug_text text="'[apirateslife] capture order: %s %s on %s: hull %s%%, shields %s%% (%s, stop at %s), distance %sm'.[this.assignedcontrolled.knownname, if $fire then 'fires' else 'holds', $target.knownname, $target.hullpercentage, $target.shieldpercentage, $target.shield, $burst, this.assignedcontrolled.distanceto.{$target}]" chance="if $fire != @$lastfire then $debugchance else 0"/>
      <set_value name="$lastfire" exact="$fire"/>

      <do_if value="$fire">
        <remove_value name="$holding"/>
        <set_value name="$firing" exact="true"/>
        <run_script name="'order.fight.attack.object'">
          <param name="primarytarget" value="$target"/>
          <param name="allowothertargets" value="false"/>
          <param name="checkrelation" value="false"/>
          <param name="pursuetargets" value="true"/>
          <param name="internalorder" value="true"/>
          <param name="debugchance" value="$debugchance"/>
        </run_script>
        <set_value name="$firing" exact="false"/>
        <!-- The attack script ended on its own (e.g. target out of reach): don't spin -->
        <wait exact="1s"/>
        <resume label="decide"/>
      </do_if>

      <!-- Hold: stop all fire, turrets included, and stay close. Stop the attack run first: one cut
           short leaves the ship flying on, and in a game test it drifted to 3 m from the prize.
           Then keep evading near the prize: a wingman sitting still while it holds is an easy
           kill for anything still shooting (lost one in Erik's game, 2026-10-27). -->
      <do_if value="not $holding?">
        <stop_moving object="this.assignedcontrolled"/>
      </do_if>
      <set_value name="$holding" exact="true"/>
      <stop_shooting object="this.assignedcontrolled"/>
      <cease_fire object="this.assignedcontrolled"/>
      <do_if value="this.assignedcontrolled.defencenpc.exists">
        <signal_objects object="this.assignedcontrolled.defencenpc" param="'attack'" comment="no target means stop attacking"/>
      </do_if>
      <!-- Close enough to knock the shields down again without a long approach: from 2.5 km, the
           game test's shields went from 34% to 90% while the wingman flew back in -->
      <do_if value="this.assignedcontrolled.distanceto.{$target} gt 1.5km">
        <move_to object="this.assignedcontrolled" destination="$target" finishonapproach="true" forcesteering="true">
          <interrupt_after_time time="1s"/>
        </move_to>
      </do_if>
      <do_else>
        <!-- Short evasive moves, as vanilla's move.evade makes them, but checking every few
             seconds whether to fire again -->
        <select_flight_behaviour entity="this" evasive="true" result="$evade"/>
        <move_to object="this.assignedcontrolled" destination="this.assignedcontrolled.zone" flightbehaviour="$evade" forcesteering="true">
          <position object="this.assignedcontrolled" min="300m" max="800m"/>
          <interrupt_after_time time="3s"/>
        </move_to>
        <set_to_default_flight_control_model object="this.assignedcontrolled"/>
      </do_else>
      <resume label="decide"/>

      <label name="finish"/>
      <stop_shooting object="this.assignedcontrolled"/>
      <cease_fire object="this.assignedcontrolled"/>
      <do_if value="this.assignedcontrolled.defencenpc.exists">
        <signal_objects object="this.assignedcontrolled.defencenpc" param="'attack'" comment="no target means stop attacking"/>
      </do_if>
      <remove_value name="this.$APiratesLife_NoMissiles"/>
      <debug_text text="'[apirateslife] capture order: %s ends on %s'.[this.assignedcontrolled.knownname, @$target.knownname]" chance="$debugchance"/>
    </actions>
  </attention>
  <!-- Cancelled by the player: missiles are allowed again -->
  <on_abort>
    <remove_value name="this.$APiratesLife_NoMissiles"/>
  </on_abort>
</aiscript>
