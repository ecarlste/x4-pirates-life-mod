<?xml version="1.0" encoding="utf-8"?>
<!-- Capture order for wingmen in a capture operation (md/apirateslife_capture.xml gives it).
     Fights the target with vanilla's attack script, but decides itself when to fire, so the target
     stays inside vanilla's bail gates instead of dying:
       break:    hull at or above $holdhull (default 75, vanilla's bail gate). While the shields
                 plus the hull above the line hold more than the wing's burst, about
                 $burstseconds of the whole wing's laser damage: fire, so shots still in flight
                 from every wingman land above the line. Inside that margin only the finisher
                 (the operation picks it, the closest wingman) fires: with every gun but one out of
                 its weapon group, one shot at a time, waiting for each to land, so it overshoots
                 the line by one bolt at most. The rest of the wing holds.
       suppress: hull below $holdhull: fire only while the target's shields hold more than
                 $burst, about 1.5 s of this wingman's laser damage, so shots still in flight land
                 on shields, not hull, whatever the weapon (heavy, slow guns get a bigger margin).
                 Fire again once shields are $shieldresume percent above that.
       floor:    hull at or below $floorhull: no fire at all
     Missiles: vanilla's attack script fires them (torpedoes too) from the first pass, and one
     already in flight kills a fighter at the hold line, as the game tests showed. So the pilot
     carries $APiratesLife_NoMissiles while this order runs, which our patch on
     aiscripts/fight.attack.object.fighter.xml reads. (Setting the missile ammo aside instead
     didn't work: vanilla still chose missile passes, with the lasers off.)
     A hand-written combat loop (shoot_at plus our own movement) was tried instead and never landed
     a shot in the game tests. See docs/specs/capture-operation.md. -->
<aiscript name="order.apirateslife.capture" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd" version="1">
  <order id="APiratesLife_Capture" name="{1774100, 101}" description="{1774100, 102}" category="internal" allowinloop="false">
    <params>
      <param name="target" required="true" type="object" text="{1041, 10126}" comment="Ship to capture">
        <input_param name="class" value="[class.ship]"/>
      </param>
      <param name="holdhull" default="75" type="internal" comment="Below this hull percentage, fire only at shields (75 is vanilla's bail gate)"/>
      <param name="floorhull" default="35" type="internal" comment="Hull percentage at or below which nobody fires"/>
      <param name="burstseconds" default="1.5" type="internal" comment="While suppressing, stop firing while the target's shields still hold this many seconds of our laser damage"/>
      <param name="shieldresume" default="10" type="internal" comment="While suppressing, fire again once shields are this many percent above the stop point"/>
      <param name="debugchance" type="internal" default="0" comment="Print debug output: 0 or 100"/>
    </params>
    <requires>
      <match shiptype="shiptype.lasertower" negate="true"/>
      <match class="class.spacesuit" negate="true"/>
    </requires>
  </order>
  <interrupts>
    <!-- Stop firing on the damage that crosses a line. Hull and shield damage events, not
         event_object_attacked, which the game tests showed fires only now and then. -->
    <handler>
      <conditions>
        <check_any>
          <event_object_hull_damaged object="$target"/>
          <event_object_shield_damaged object="$target"/>
        </check_any>
        <check_value value="$firing"/>
        <check_value value="not $target.isoperational or ($target.hullpercentage ge $holdhull and $target.shield + $target.hull - $target.maxhull * $holdhull / 100.0 le $wingburst) or ($target.hullpercentage lt $holdhull and (($target.hullpercentage le $floorhull) or (not $target.maxshield) or ($target.shield le $burst)))"/>
      </conditions>
      <actions>
        <debug_text text="'[apirateslife] capture order: %s holds on %s: hull %s%%, shields %s%% (%s, stop at %s)'.[this.assignedcontrolled.knownname, event.name, @$target.hullpercentage, @$target.shieldpercentage, @$target.shield, $burst]" chance="$debugchance"/>
        <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s stops: hull %s%%, shield %s, margin %s, wing burst %s (own %s)'.[this.assignedcontrolled.knownname, @$target.hullpercentage, @$target.shield, @$target.shield + @$target.hull - @$target.maxhull * $holdhull / 100.0, $wingburst, $burst]"/>
        <set_value name="$firing" exact="false"/>
        <abort_called_scripts resume="decide"/>
      </actions>
    </handler>
    <!-- Finisher: stop on the one shot. Also counts every shot fired during a fine-stage step. -->
    <handler>
      <conditions>
        <event_weapon_fired group="$guns"/>
        <check_value value="$step"/>
      </conditions>
      <actions>
        <set_value name="$stepshots" exact="$stepshots + 1"/>
        <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s shot %s of the step by %s (%s), %s into the step'.[this.assignedcontrolled.knownname, $stepshots, event.object, if event.object == $finishgun then 'finisher gun' else 'OTHER gun', player.age - $stepstart]"/>
        <do_if value="$shooting">
          <set_value name="$shooting" exact="false"/>
          <stop_shooting object="this.assignedcontrolled"/>
          <cease_fire object="this.assignedcontrolled"/>
          <abort_called_scripts resume="fired"/>
        </do_if>
      </actions>
    </handler>
    <!-- The operation ended (abandoned, called off...): stop at once, even mid-attack -->
    <handler>
      <conditions>
        <event_object_signalled object="this.assignedcontrolled" param="'apirateslife_capture_end'"/>
        <check_value value="event.param2 == $target"/>
      </conditions>
      <actions>
        <set_value name="$firing" exact="false"/>
        <set_value name="$ended" exact="true"/>
        <abort_called_scripts resume="finish"/>
      </actions>
    </handler>
  </interrupts>
  <init>
    <set_command command="command.attackobject" param="$target"/>
    <set_value name="$firing" exact="false"/>
    <set_value name="$ended" exact="false"/>
    <set_value name="$burst" exact="0"/>
    <set_value name="$wingburst" exact="0"/>
    <!-- Fine stage: the one gun the finisher fires, the guns it took out of $weapongroup, and
         whether a step (one shot and its wait) or its shot is under way -->
    <set_value name="$finishgun" exact="null"/>
    <set_value name="$removedguns" exact="[]"/>
    <set_value name="$weapongroup" exact="0"/>
    <set_value name="$step" exact="false"/>
    <set_value name="$shooting" exact="false"/>
    <set_value name="$stepshots" exact="0"/>
    <set_value name="$stepstart" exact="0s"/>
    <create_group groupname="$guns"/>
    <add_to_group groupname="$guns" list="this.assignedcontrolled.weapons.operational.list"/>
  </init>
  <attention min="unknown">
    <actions>
      <!-- No missiles (see the top of this file) -->
      <set_value name="this.$APiratesLife_NoMissiles" exact="true"/>
      <!-- The target turns hostile to the player now that this order is running, so we may fire:
           player-owned ships won't attack a ship they aren't hostile to (see
           md/apirateslife_capture.xml, Operation) -->
      <do_if value="not this.assignedcontrolled.mayattack.{$target}">
        <set_relation_boost object="$target" faction="faction.player" value="-1" decay="1" delay="600s" reason="relationchangereason.markedashostile"/>
      </do_if>

      <label name="decide"/>
      <set_value name="$firing" exact="false"/>
      <!-- The operation is over (or the prize is taken or lost) -->
      <do_if value="$ended or not @$target.isoperational or $target.isplayerowned or $target.trueowner == faction.ownerless or not @global.$APiratesLife_CaptureOps.{$target}">
        <resume label="finish"/>
      </do_if>

      <!-- Follow the target into another sector -->
      <do_if value="this.sector != $target.sector">
        <run_script name="'move.generic'" result="$movesuccess">
          <param name="destination" value="$target"/>
          <param name="debugchance" value="$debugchance"/>
        </run_script>
        <do_if value="not $movesuccess">
          <resume label="finish"/>
        </do_if>
        <resume label="decide"/>
      </do_if>

      <!-- What may still land after we stop: about $burstseconds of our laser fire, in hitpoints.
           Recomputed each time, as weapons can be lost in the fight, but not while the finisher
           has guns out of the group, as the DPS may then count only the one left. -->
      <do_if value="not $finishgun">
        <set_value name="$burst" exact="this.assignedcontrolled.dps.lasers.all * $burstseconds"/>
      </do_if>
      <!-- The same for the whole wing attacking this target, as the operation keeps it -->
      <set_value name="$wingdps" exact="@global.$APiratesLife_CaptureOps.{$target}.$wingdps"/>
      <set_value name="$wingburst" exact="if $wingdps then [$wingdps * $burstseconds, $burst].max else $burst"/>
      <!-- What the wing may still take off before the hull reaches the hold line, shields first -->
      <set_value name="$margin" exact="$target.shield + $target.hull - $target.maxhull * $holdhull / 100.0"/>
      <set_value name="$finishing" exact="false"/>

      <!-- Break: the whole wing fires while its burst still lands above the hold line. Inside that
           margin only the finisher fires, one shot at a time. -->
      <do_if value="$target.hullpercentage ge $holdhull">
        <set_value name="$fire" exact="$margin gt $wingburst"/>
        <set_value name="$finishing" exact="not $fire and @global.$APiratesLife_CaptureOps.{$target}.$finisher == this.assignedcontrolled"/>
      </do_if>
      <!-- Floor: never below it -->
      <do_elseif value="$target.hullpercentage le $floorhull">
        <set_value name="$fire" exact="false"/>
      </do_elseif>
      <!-- Suppress: knock shields down once they've regenerated enough, stopping (in the hit
           handler) while they still hold our burst. A heavily armed wingman may leave shields above
           the 20% gate; the player or a lighter wingman takes them the rest of the way. -->
      <do_else>
        <set_value name="$fire" exact="$target.maxshield and $target.shield ge $burst + $target.maxshield * $shieldresume / 100.0"/>
      </do_else>

      <debug_text text="'[apirateslife] capture order: %s %s on %s: hull %s%%, shields %s%% (%s, stop at %s), distance %sm'.[this.assignedcontrolled.knownname, if $fire then 'fires' else 'holds', $target.knownname, $target.hullpercentage, $target.shieldpercentage, $target.shield, $burst, this.assignedcontrolled.distanceto.{$target}]" chance="if $fire != @$lastfire then $debugchance else 0"/>
      <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s %s: hull %s%%, shield %s, margin %s, wing burst %s (own %s), dps now %s'.[this.assignedcontrolled.knownname, if $fire then 'fires' else if $finishing then 'finishes' else 'holds', $target.hullpercentage, $target.shield, $margin, $wingburst, $burst, this.assignedcontrolled.dps.lasers.all]" chance="if $fire != @$lastfire or $finishing != @$lastfinishing then 100 else 0"/>
      <set_value name="$lastfire" exact="$fire"/>
      <set_value name="$lastfinishing" exact="$finishing"/>

      <!-- Out of the fine stage: put the guns back in the group -->
      <do_if value="$finishgun and not $finishing">
        <do_for_each name="$gun" in="$removedguns">
          <do_if value="$gun.exists">
            <add_weapon_to_weapongroup weapon="$gun" weapongroup="$weapongroup" primary="true"/>
          </do_if>
        </do_for_each>
        <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s puts %s guns back in group %s: %s in it, dps now %s'.[this.assignedcontrolled.knownname, $removedguns.count, $weapongroup, this.assignedcontrolled.primaryweapons.{$weapongroup}.count, this.assignedcontrolled.dps.lasers.all]"/>
        <set_value name="$removedguns" exact="[]"/>
        <set_value name="$finishgun" exact="null"/>
        <remove_value name="this.$APiratesLife_Dps"/>
      </do_if>

      <do_if value="$fire">
        <remove_value name="$holding"/>
        <set_value name="$firing" exact="true"/>
        <run_script name="'order.fight.attack.object'">
          <param name="primarytarget" value="$target"/>
          <param name="allowothertargets" value="false"/>
          <param name="checkrelation" value="false"/>
          <param name="pursuetargets" value="true"/>
          <param name="internalorder" value="true"/>
          <param name="debugchance" value="$debugchance"/>
        </run_script>
        <set_value name="$firing" exact="false"/>
        <!-- The attack script ended on its own (e.g. target out of reach): don't spin -->
        <wait exact="1s"/>
        <resume label="decide"/>
      </do_if>

      <!-- Fine stage, the finisher: take every gun but one out of the active weapon group, so
           vanilla's attack script still aims but fires that one gun, and stop on its first shot
           (the handler on event_weapon_fired resumes at "fired"). The wing's DPS is read before
           (WingDps reads it from the pilot), as it may count only the guns left in the group. -->
      <do_if value="$finishing">
        <do_if value="not $finishgun">
          <set_value name="this.$APiratesLife_Dps" exact="this.assignedcontrolled.dps.lasers.all"/>
          <set_value name="$weapongroup" exact="this.assignedcontrolled.activeweapongroup.primary"/>
          <do_for_each name="$gun" in="this.assignedcontrolled.primaryweapons.{$weapongroup}.list">
            <do_if value="not $finishgun and $gun.isoperational and not $gun.isclass.turret">
              <set_value name="$finishgun" exact="$gun"/>
            </do_if>
            <do_else>
              <remove_weapon_from_weapongroup weapon="$gun" weapongroup="$weapongroup" primary="true"/>
              <append_to_list name="$removedguns" exact="$gun"/>
            </do_else>
          </do_for_each>
          <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s starts finishing: keeps %s in group %s, took %s out (%s left in it), dps before %s, now %s'.[this.assignedcontrolled.knownname, $finishgun, $weapongroup, $removedguns.count, this.assignedcontrolled.primaryweapons.{$weapongroup}.count, this.$APiratesLife_Dps, this.assignedcontrolled.dps.lasers.all]"/>
        </do_if>
        <do_if value="$finishgun">
          <remove_value name="$holding"/>
          <set_value name="$stepshots" exact="0"/>
          <set_value name="$stepstart" exact="player.age"/>
          <set_value name="$stephull" exact="$target.hullpercentage"/>
          <set_value name="$stepshield" exact="$target.shield"/>
          <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s fires one shot: hull %s%% (%s), shield %s, margin %s, distance %sm'.[this.assignedcontrolled.knownname, $target.hullpercentage, $target.hull, $target.shield, $margin, this.assignedcontrolled.distanceto.{$target}]"/>
          <set_value name="$step" exact="true"/>
          <set_value name="$shooting" exact="true"/>
          <run_script name="'order.fight.attack.object'">
            <param name="primarytarget" value="$target"/>
            <param name="allowothertargets" value="false"/>
            <param name="checkrelation" value="false"/>
            <param name="pursuetargets" value="true"/>
            <param name="internalorder" value="true"/>
            <param name="debugchance" value="$debugchance"/>
          </run_script>
          <set_value name="$shooting" exact="false"/>
          <set_value name="$step" exact="false"/>
          <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s attack ended without a shot'.[this.assignedcontrolled.knownname]"/>
          <wait exact="1s"/>
          <resume label="decide"/>
        </do_if>
      </do_if>

      <!-- Hold: stop all fire, turrets included, and stay close. Stop the attack run first: one cut
           short leaves the ship flying on, and in a game test it drifted to 3 m from the prize.
           Then keep evading near the prize: a wingman sitting still while it holds is an easy
           kill for anything still shooting (lost one in Erik's game, 2026-10-27). -->
      <do_if value="not $holding?">
        <stop_moving object="this.assignedcontrolled"/>
      </do_if>
      <set_value name="$holding" exact="true"/>
      <stop_shooting object="this.assignedcontrolled"/>
      <cease_fire object="this.assignedcontrolled"/>
      <do_if value="this.assignedcontrolled.defencenpc.exists">
        <signal_objects object="this.assignedcontrolled.defencenpc" param="'attack'" comment="no target means stop attacking"/>
      </do_if>
      <!-- Close enough to knock the shields down again without a long approach: from 2.5 km, the
           game test's shields went from 34% to 90% while the wingman flew back in -->
      <do_if value="this.assignedcontrolled.distanceto.{$target} gt 1.5km">
        <move_to object="this.assignedcontrolled" destination="$target" finishonapproach="true" forcesteering="true">
          <interrupt_after_time time="1s"/>
        </move_to>
      </do_if>
      <do_else>
        <!-- Short evasive moves, as vanilla's move.evade makes them, but checking every few
             seconds whether to fire again -->
        <select_flight_behaviour entity="this" evasive="true" result="$evade"/>
        <move_to object="this.assignedcontrolled" destination="this.assignedcontrolled.zone" flightbehaviour="$evade" forcesteering="true">
          <position object="this.assignedcontrolled" min="300m" max="800m"/>
          <interrupt_after_time time="3s"/>
        </move_to>
        <set_to_default_flight_control_model object="this.assignedcontrolled"/>
      </do_else>
      <resume label="decide"/>

      <!-- Fine stage: the shot is out. Wait for it (or anything) to land, or about 1 s, and decide
           again. -->
      <label name="fired"/>
      <wait exact="1s">
        <interrupt>
          <conditions>
            <check_any>
              <event_object_hull_damaged object="$target"/>
              <event_object_shield_damaged object="$target"/>
            </check_any>
          </conditions>
        </interrupt>
      </wait>
      <set_value name="$step" exact="false"/>
      <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s step done in %s: %s shots, hull %s%% to %s%%, shield %s to %s'.[this.assignedcontrolled.knownname, player.age - $stepstart, $stepshots, $stephull, @$target.hullpercentage, $stepshield, @$target.shield]"/>
      <resume label="decide"/>

      <label name="finish"/>
      <set_value name="$step" exact="false"/>
      <do_for_each name="$gun" in="$removedguns">
        <do_if value="$gun.exists">
          <add_weapon_to_weapongroup weapon="$gun" weapongroup="$weapongroup" primary="true"/>
        </do_if>
      </do_for_each>
      <debug_text text="'[apirateslife] [DEBUG-172] capture order: %s ends, puts %s guns back in group %s'.[this.assignedcontrolled.knownname, $removedguns.count, $weapongroup]" chance="if $removedguns.count then 100 else 0"/>
      <set_value name="$removedguns" exact="[]"/>
      <remove_value name="this.$APiratesLife_Dps"/>
      <stop_shooting object="this.assignedcontrolled"/>
      <cease_fire object="this.assignedcontrolled"/>
      <do_if value="this.assignedcontrolled.defencenpc.exists">
        <signal_objects object="this.assignedcontrolled.defencenpc" param="'attack'" comment="no target means stop attacking"/>
      </do_if>
      <remove_value name="this.$APiratesLife_NoMissiles"/>
      <debug_text text="'[apirateslife] capture order: %s ends on %s'.[this.assignedcontrolled.knownname, @$target.knownname]" chance="$debugchance"/>
    </actions>
  </attention>
  <!-- Cancelled by the player: missiles are allowed again, and the finisher's guns go back in
       the group -->
  <on_abort>
    <remove_value name="this.$APiratesLife_NoMissiles"/>
    <do_for_each name="$gun" in="$removedguns">
      <do_if value="$gun.exists">
        <add_weapon_to_weapongroup weapon="$gun" weapongroup="$weapongroup" primary="true"/>
      </do_if>
    </do_for_each>
    <remove_value name="this.$APiratesLife_Dps"/>
  </on_abort>
</aiscript>
