#!/usr/bin/env bash
# Keeps attribution lines out of commits: commits and PRs are authored by Erik only, with no
# co-author trailers, session links or "Generated with/by" lines (docs/PROJECT.md, Workflow rules).
# Turned on by make setup (git config core.hooksPath .githooks). PRs are squash-merged with their
# description as the commit body, so CI (.github/workflows/pr-body.yml) runs it on that too.
# The patterns below are the one list of what's refused.
#
# Usage: commit-msg <message-file>          git runs it so, before each commit
#        commit-msg --pr-body <body-file>   CI, on a PR's description

pr_body=false
what="commit-msg: this commit message has"
if [ "${1:-}" = --pr-body ]; then
    pr_body=true
    what="PR description: it becomes the commit body on main, and it has"
    shift
fi
msg_file=${1:-}

if [ ! -r "$msg_file" ]; then
    echo "commit-msg: can't read the message file '$msg_file'" >&2
    exit 2
fi

# One pattern per kind of line refused, matched ignoring case
patterns=(
    '^[[:space:]]*co-authored-by:'                       # a co-author trailer
    'claude\.ai/code/session'                            # a Claude session link
    '^[^-*+[:alnum:]]*generated (with|by)([^[:alnum:]]|$)'  # "🤖 Generated with …"; not a list item or a sentence's "generated by"
)
args=()
for p in "${patterns[@]}"; do args+=(-e "$p"); done

# git commit -v puts the staged diff below a scissors line ("# ---- >8 ----"); git drops it from
# the commit, so it isn't checked. A PR description has no such part: all of it is checked.
if $pr_body; then
    text=$(cat "$msg_file")
else
    text=$(sed -E '/^. -+ >8 -+$/,$d' "$msg_file")
fi

if found=$(grep -inE "${args[@]}" <<<"$text"); then
    echo "$what attribution lines. Commits and PRs carry no co-author trailers, session links or" >&2
    echo "\"Generated with/by\" lines (docs/PROJECT.md, Workflow rules). Remove (line: text):" >&2
    echo "$found" >&2
    exit 1
fi
