<?xml version="1.0" encoding="utf-8"?>
<!-- The vanilla profile's pirate variants: which vanilla ships (and later gear) get a pirate
     version, with which rig, and at which standing level a group offers its unlock. Read by
     tools/generate_variants.py, which writes the variants into the mod (see docs/specs/booty.md,
     Variants, and docs/DESIGN.md, Booty and pirate standing). Not shipped: only the generated files
     are. After changing this file, run `make variants` and commit what it writes.

     <group>   the pirate group the variants are sold by: its id (as in the profile's Groups), the
               factions that own the variants (so their wharfs and shipyards sell them), and the
               shown name used in unlock texts.
     <rig>     a pirate rig: multipliers on the vanilla ship's properties.
                 drag         all forward, reverse and sideways drag (lower is faster, in every mode)
                 travelaccel  the travel drive's acceleration (jerk forward_travel accel)
                 hull         maximum hull
                 crew         crew capacity (people), rounded, at least the vanilla value + 1
                 cargo        cargo capacity, through a copy of the ship's storage macro
               Still being worked out (docs/research/pirate-variants.md, Pirate rigs).
               Equipment rigs (agreed 2026-10-27, to tune by feel):
                 engines      thrust (combat), reverse, travelthrust, boostthrust, boostduration,
                              boostrecharge (the boost recharge *rate*: below 1 is slower)
                 shields      capacity, rate, delay (the wait before recharging)
                 weapons      hulldamage, shielddamage, through a copy of the weapon's bullet macro
                              (turrets the same)
                 missiles     disable: how long the missile's effects (the EMP's boost and travel
                              shutdown) last
     <ship>    a variant: id (short, unique, used in generated IDs), the vanilla macro, its rig, the
               standing level whose unlock offers it, and the role (for the reader).
     <equipment> the same for an engine, shield generator, weapon, turret or missile; name gives something
               new a fun name in place of its base name (docs/DESIGN.md: "Pirate" for a pirate version
               of existing gear, a fun name for something new). -->
<variants>
  <group id="vigor" factions="loanshark" name="Vigor Syndicate"/>

  <rig id="raider" drag="0.85" travelaccel="1.25" hull="0.85" cargo="1.5"/>
  <rig id="swarm" drag="0.9" travelaccel="1.25" hull="0.8"/>
  <rig id="prizerunner" drag="0.9" travelaccel="1.15" hull="0.9" crew="1.25" cargo="1.5"/>
  <rig id="boarder" drag="0.9" travelaccel="1.15" hull="1.1" crew="1.5" cargo="0.6"/>
  <rig id="flagship" drag="0.85" travelaccel="1.2" hull="0.9" crew="1.25" cargo="1.25"/>
  <rig id="mothership" drag="0.8" travelaccel="1.2" hull="0.9" crew="1.2"/>

  <!-- Pirate engines are built for the burst: a bigger, shorter boost that's slower to come back,
       and a weak reverse, so a pirate who comes in hot overshoots -->
  <rig id="engine_combat" thrust="1.1" travelthrust="1.15" boostthrust="1.3" boostduration="0.7" boostrecharge="0.77" reverse="0.7"/>
  <rig id="engine_allround" thrust="1.05" travelthrust="1.2" boostthrust="1.3" boostduration="0.7" boostrecharge="0.77" reverse="0.7"/>
  <rig id="engine_travel" thrust="0.9" travelthrust="1.3" boostthrust="1.3" boostduration="0.7" boostrecharge="0.77" reverse="0.7"/>
  <rig id="shield_quick" capacity="0.85" delay="0.7"/>
  <rig id="stripper" hulldamage="0.6" shielddamage="1.3"/>
  <!-- No ion turret in vanilla: the Stripper turret is built on the Teladi muon blaster turret, which
       starts at about 2:3 shield to hull, so it needs a stronger rig to reach the Stripper's 8:1 -->
  <rig id="stripper_turret" hulldamage="0.33" shielddamage="4"/>
  <rig id="emp_long" disable="1.5"/>

  <ship id="kyd" macro="ship_pir_s_fighter_01_a_macro" rig="swarm" level="1" role="swarm skiff"/>
  <ship id="lux" macro="ship_pir_s_fighter_02_a_macro" rig="raider" level="2" role="raider"/>
  <ship id="hermes" macro="ship_par_m_trans_container_02_a_macro" rig="boarder" level="4" role="boarding transport"/>
  <ship id="gorgon" macro="ship_par_m_frigate_01_a_macro" rig="prizerunner" level="6" role="prize runner"/>
  <ship id="barbarossa" macro="ship_pir_l_scavenger_01_a_macro" rig="flagship" level="9" role="raider flagship"/>
  <ship id="atlas" macro="ship_par_xl_resupplier_02_a_macro" rig="mothership" level="16" role="mothership"/>

  <!-- S gear at levels 2 and 3, M gear with the Gorgon at 6 -->
  <equipment id="stripper_s" macro="weapon_arg_s_ion_01_mk1_macro" rig="stripper" name="Stripper" level="2"/>
  <equipment id="combat_s" macro="engine_arg_s_combat_01_mk1_macro" rig="engine_combat" level="3"/>
  <equipment id="allround_s" macro="engine_arg_s_allround_01_mk1_macro" rig="engine_allround" level="3"/>
  <equipment id="travel_s" macro="engine_arg_s_travel_01_mk1_macro" rig="engine_travel" level="3"/>
  <equipment id="quick_s" macro="shield_arg_s_standard_01_mk1_macro" rig="shield_quick" level="3"/>
  <equipment id="coldfeet" macro="missile_emp_mk1_macro" rig="emp_long" name="Cold Feet" level="3"/>
  <equipment id="stripper_m" macro="weapon_arg_m_ion_01_mk1_macro" rig="stripper" name="Stripper" level="6"/>
  <equipment id="combat_m" macro="engine_arg_m_combat_01_mk1_macro" rig="engine_combat" level="6"/>
  <equipment id="allround_m" macro="engine_arg_m_allround_01_mk1_macro" rig="engine_allround" level="6"/>
  <equipment id="travel_m" macro="engine_arg_m_travel_01_mk1_macro" rig="engine_travel" level="6"/>
  <equipment id="quick_m" macro="shield_arg_m_standard_01_mk1_macro" rig="shield_quick" level="6"/>
  <equipment id="stripper_turret_m" macro="turret_tel_m_shotgun_01_mk1_macro" rig="stripper_turret" name="Stripper Turret" level="6"/>
</variants>
