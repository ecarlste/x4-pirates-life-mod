#!/usr/bin/env bats
# Tests for the repo's git hooks (.githooks/, turned on by make setup). The pre-commit hook keeps
# commits off main: every change goes through a feature branch and a PR (docs/PROJECT.md, Workflow rules).
# The commit-msg hook refuses attribution lines in commit messages, and CI runs it on PR descriptions.

load helpers

setup() {
    setup_sandbox
    mkdir -p "$REPO/.githooks"
    cp "$REPO_ROOT/.githooks/pre-commit" "$REPO_ROOT/.githooks/commit-msg" "$REPO/.githooks/"
    git -C "$REPO" config core.hooksPath .githooks
    echo change > "$REPO/docs/notes.md"
    git -C "$REPO" add docs/notes.md
}
teardown() { if [ -n "${SANDBOX:-}" ]; then teardown_sandbox; fi; }

@test "a commit on main is refused, naming the way out" {
    run git -C "$REPO" commit -q -m "on main"
    [ "$status" -ne 0 ]
    [[ "$output" == *"git switch -c feature/"* ]]
    [ "$(git -C "$REPO" rev-list --count main)" -eq 1 ]
}

@test "a commit on a feature branch goes through" {
    git -C "$REPO" switch -q -c feature/thing
    run git -C "$REPO" commit -q -m "on a branch"
    [ "$status" -eq 0 ]
    [ "$(git -C "$REPO" rev-list --count feature/thing)" -eq 2 ]
}

@test "a commit on a detached HEAD goes through, as a rebase makes" {
    git -C "$REPO" switch -q --detach
    run git -C "$REPO" commit -q -m "detached"
    [ "$status" -eq 0 ]
}

@test "a commit with a co-author trailer is refused, naming the line" {
    git -C "$REPO" switch -q -c feature/thing
    run git -C "$REPO" commit -q -m "a change" -m "Co-authored-by: Someone <someone@example.com>"
    [ "$status" -ne 0 ]
    [[ "$output" == *"Co-authored-by: Someone"* ]]
    [ "$(git -C "$REPO" rev-list --count feature/thing)" -eq 1 ]
}

@test "a commit with a Claude session link is refused" {
    git -C "$REPO" switch -q -c feature/thing
    run git -C "$REPO" commit -q -m "a change" -m "https://claude.ai/code/session_01AbCdEf"
    [ "$status" -ne 0 ]
    [[ "$output" == *"claude.ai/code/session_01AbCdEf"* ]]
}

@test "a commit with a Generated with or Generated by line is refused" {
    git -C "$REPO" switch -q -c feature/thing
    run git -C "$REPO" commit -q -m "a change" -m "🤖 Generated with [Some Tool](https://example.com)"
    [ "$status" -ne 0 ]
    [[ "$output" == *"Generated with [Some Tool]"* ]]
    run git -C "$REPO" commit -q -m "a change" -m "Generated by Some Tool"
    [ "$status" -ne 0 ]
}

@test "a commit that only mentions generated files in a sentence goes through" {
    git -C "$REPO" switch -q -c feature/thing
    run git -C "$REPO" commit -q -m "docs: regenerate the test plan" -m "The pages are generated by make test-plan."
    [ "$status" -eq 0 ]
}

@test "the diff git commit -v adds below the scissors line isn't checked" {
    git -C "$REPO" switch -q -c feature/thing
    echo "see https://claude.ai/code/session_01AbCdEf" > "$REPO/docs/notes.md"
    git -C "$REPO" add docs/notes.md
    run env GIT_EDITOR="sed -i '1i a change'" git -C "$REPO" commit -q -v
    [ "$status" -eq 0 ]
    [ "$(git -C "$REPO" log -1 --format=%s)" = "a change" ]
}

@test "a PR description with an attribution line is refused, as CI checks it" {
    printf '## Changes\n\n- a change\n\nCo-authored-by: Someone <someone@example.com>\n' > "$SANDBOX/body.md"
    run "$REPO_ROOT/.githooks/commit-msg" --pr-body "$SANDBOX/body.md"
    [ "$status" -ne 0 ]
    [[ "$output" == *"PR description"* ]]
    [[ "$output" == *"Co-authored-by: Someone"* ]]
}

@test "a clean PR description passes" {
    printf '## Changes\n\n- a change, generated by make test-plan\n' > "$SANDBOX/body.md"
    run "$REPO_ROOT/.githooks/commit-msg" --pr-body "$SANDBOX/body.md"
    [ "$status" -eq 0 ]
}

@test "a Generated by line with a colon is refused, a list item about generated pages isn't" {
    printf 'Generated by: Some Tool\n' > "$SANDBOX/body.md"
    run "$REPO_ROOT/.githooks/commit-msg" --pr-body "$SANDBOX/body.md"
    [ "$status" -ne 0 ]
    printf -- '- Generated by make test-plan: docs/test-plan/\n' > "$SANDBOX/body.md"
    run "$REPO_ROOT/.githooks/commit-msg" --pr-body "$SANDBOX/body.md"
    [ "$status" -eq 0 ]
}

@test "a scissors-like line in a PR description doesn't hide what follows it" {
    printf '# --- >8 ---\nCo-authored-by: Someone <someone@example.com>\n' > "$SANDBOX/body.md"
    run "$REPO_ROOT/.githooks/commit-msg" --pr-body "$SANDBOX/body.md"
    [ "$status" -ne 0 ]
}

@test "a missing message file fails rather than passing unchecked" {
    run "$REPO_ROOT/.githooks/commit-msg" --pr-body "$SANDBOX/no-such-file.md"
    [ "$status" -ne 0 ]
    [[ "$output" == *"no-such-file.md"* ]]
}
