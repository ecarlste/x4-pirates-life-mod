<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed loadouts for test ships, so combat tests don't depend on a random loadout (slow mass
     drivers barely landing a shot, or torpedoes one-shotting the target): an Argon Nova with two
     pulse lasers and no missile launcher. -->
<diff>
  <add sel="/loadouts">
    <loadout id="apirateslife_test_nova_lasers" macro="ship_arg_s_fighter_01_a_macro">
      <macros>
        <engine macro="engine_arg_s_combat_01_mk1_macro" path="../con_engine_01"/>
        <engine macro="engine_arg_s_combat_01_mk1_macro" path="../con_engine_02"/>
        <shield macro="shield_arg_s_standard_01_mk1_macro" path="../con_shield_01"/>
        <weapon macro="weapon_gen_s_laser_01_mk1_macro" path="../con_primaryweapon_01"/>
        <weapon macro="weapon_gen_s_laser_01_mk1_macro" path="../con_primaryweapon_02"/>
      </macros>
      <virtualmacros>
        <thruster macro="thruster_gen_s_allround_01_mk1_macro"/>
      </virtualmacros>
    </loadout>
    <!-- A Nova with pirate gear (the variant_gear game test) -->
    <loadout id="apirateslife_test_nova_pirategear" macro="ship_arg_s_fighter_01_a_macro">
      <macros>
        <engine macro="engine_apl_combat_s_macro" path="../con_engine_01"/>
        <engine macro="engine_apl_combat_s_macro" path="../con_engine_02"/>
        <shield macro="shield_apl_quick_s_macro" path="../con_shield_01"/>
        <weapon macro="weapon_apl_stripper_s_macro" path="../con_primaryweapon_01"/>
      </macros>
      <virtualmacros>
        <thruster macro="thruster_gen_s_allround_01_mk1_macro"/>
      </virtualmacros>
    </loadout>
    <!-- A Nova with the vanilla gear the pirate gear is a rig of (the variant_gear game test) -->
    <loadout id="apirateslife_test_nova_vanillagear" macro="ship_arg_s_fighter_01_a_macro">
      <macros>
        <engine macro="engine_arg_s_combat_01_mk1_macro" path="../con_engine_01"/>
        <engine macro="engine_arg_s_combat_01_mk1_macro" path="../con_engine_02"/>
        <shield macro="shield_arg_s_standard_01_mk1_macro" path="../con_shield_01"/>
        <weapon macro="weapon_arg_s_ion_01_mk1_macro" path="../con_primaryweapon_01"/>
      </macros>
      <virtualmacros>
        <thruster macro="thruster_gen_s_allround_01_mk1_macro"/>
      </virtualmacros>
    </loadout>
    <!-- Stripper turrets on an M hull, where turrets can't be shot off, and on an L hull, which
         takes the destructible twin, as vanilla's L loadouts do (the variant_turret game test) -->
    <loadout id="apirateslife_test_gorgon_stripperturret" macro="ship_par_m_frigate_01_a_macro">
      <macros>
        <turret macro="turret_apl_stripper_turret_m_macro" path="../con_turret_front_R"/>
        <turret macro="turret_apl_stripper_turret_m_macro" path="../con_turret_front_L"/>
      </macros>
    </loadout>
    <loadout id="apirateslife_test_barbarossa_stripperturret" macro="ship_pir_l_scavenger_01_a_macro">
      <groups>
        <turrets macro="turret_apl_stripper_turret_m_alias_macro" path=".." group="group_back_mid_down" min="2" max="2"/>
      </groups>
    </loadout>
  </add>
</diff>
