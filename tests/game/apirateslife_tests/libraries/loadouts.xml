<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed loadouts for test ships, so combat tests don't depend on a random loadout (slow guns
     barely landing a shot, or torpedoes one-shotting the target), and the player's ships get
     engines (under SWI, a level loadout for the player faction gets none). Both are SWI's own
     X-wing loadout (sw_xwing_mc80start, SWI libraries/loadouts.xml), made fixed:
       - apirateslife_test_xwing_lasers: its four KX7 lasers, without the two proton torpedo
         launchers and their ammunition;
       - apirateslife_test_xwing_torpedoes: all of it, for the no-missiles tests. -->
<diff>
  <add sel="/loadouts">
    <loadout id="apirateslife_test_xwing_lasers" macro="t65b_xwing_macro">
      <macros>
        <engine macro="engine_xwing_macro" path="../con_engine_01"/>
        <engine macro="engine_xwing_macro" path="../con_engine_02"/>
        <engine macro="engine_xwing_macro" path="../con_engine_03"/>
        <engine macro="engine_xwing_macro" path="../con_engine_04"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_01"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_02"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_03"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_04"/>
        <!-- SWI's loadout puts both of these on con_shield_01; the X-wing has con_shield_02 -->
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_01"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_02"/>
        <shield macro="shield_s_r2astro_macro" path="../con_shield_03"/>
      </macros>
      <ammunition>
        <ammunition macro="countermeasure_flares_01_macro" exact="8"/>
      </ammunition>
      <software>
        <software ware="software_dockmk1"/>
        <software ware="software_flightassistmk1"/>
        <software ware="software_scannerlongrangemk2"/>
        <software ware="software_scannerobjectmk2"/>
        <software ware="software_targetmk1"/>
      </software>
      <virtualmacros>
        <thruster macro="thruster_gen_s_allround_01_mk2_macro"/>
      </virtualmacros>
    </loadout>
    <loadout id="apirateslife_test_xwing_torpedoes" macro="t65b_xwing_macro">
      <macros>
        <engine macro="engine_xwing_macro" path="../con_engine_01"/>
        <engine macro="engine_xwing_macro" path="../con_engine_02"/>
        <engine macro="engine_xwing_macro" path="../con_engine_03"/>
        <engine macro="engine_xwing_macro" path="../con_engine_04"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_01"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_02"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_03"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_04"/>
        <weapon macro="weapon_krupx_s_guided_macro" path="../con_weapon_05"/>
        <weapon macro="weapon_krupx_s_guided_macro" path="../con_weapon_06"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_01"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_02"/>
        <shield macro="shield_s_r2astro_macro" path="../con_shield_03"/>
      </macros>
      <ammunition>
        <ammunition macro="missile_proton_light_macro" exact="12"/>
        <ammunition macro="countermeasure_flares_01_macro" exact="8"/>
      </ammunition>
      <software>
        <software ware="software_dockmk1"/>
        <software ware="software_flightassistmk1"/>
        <software ware="software_scannerlongrangemk2"/>
        <software ware="software_scannerobjectmk2"/>
        <software ware="software_targetmk1"/>
      </software>
      <virtualmacros>
        <thruster macro="thruster_gen_s_allround_01_mk2_macro"/>
      </virtualmacros>
    </loadout>
    <!-- #184: a Y-wing (BTL-A4) with its two KX7 lasers and its SW4 top turret, without the two
         bomb launchers. SWI has no loadout of its own for it: the parts are the ones its slots
         take (engine_r200 fits its koensayr engine slots). -->
    <loadout id="apirateslife_test_ywing_turret" macro="ywing_btla4_macro">
      <macros>
        <engine macro="engine_r200_macro" path="../con_engine_01"/>
        <engine macro="engine_r200_macro" path="../con_engine_02"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_01"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_02"/>
        <turret macro="weapon_sw4_s_laser_macro" path="../con_weapon_03"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_01"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_02"/>
        <shield macro="shield_s_r2astro_macro" path="../con_shield_03"/>
      </macros>
      <ammunition>
