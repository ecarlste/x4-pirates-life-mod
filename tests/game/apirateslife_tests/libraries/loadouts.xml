      </software>
      <virtualmacros>
        <thruster macro="thruster_gen_m_allround_01_mk2_macro"/>
      </virtualmacros>
    </loadout>
    <loadout id="apirateslife_test_yt1300_noturrets" macro="yt1300_01_a_macro">
      <macros>
        <engine macro="engine_yt_macro" path="../con_engine_01"/>
        <weapon macro="weapon_kx20_m_laser_macro" path="../con_weapon_01"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_01"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_02"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_03"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_04"/>
      </macros>
      <ammunition>
        <ammunition macro="countermeasure_flares_01_macro" exact="8"/>
