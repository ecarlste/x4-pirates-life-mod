        <software ware="software_flightassistmk1"/>
        <software ware="software_scannerlongrangemk2"/>
        <software ware="software_scannerobjectmk2"/>
        <software ware="software_targetmk1"/>
      </software>
      <virtualmacros>
        <thruster macro="thruster_gen_s_allround_01_mk2_macro"/>
      </virtualmacros>
    </loadout>
    <!-- The same Y-wing without its turret, to compare its DPS with (#184) -->
    <loadout id="apirateslife_test_ywing_noturret" macro="ywing_btla4_macro">
      <macros>
        <engine macro="engine_r200_macro" path="../con_engine_01"/>
        <engine macro="engine_r200_macro" path="../con_engine_02"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_01"/>
        <weapon macro="weapon_kx7_s_laser_macro" path="../con_weapon_02"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_01"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_02"/>
        <shield macro="shield_s_r2astro_macro" path="../con_shield_03"/>
      </macros>
      <ammunition>
        <ammunition macro="countermeasure_flares_01_macro" exact="8"/>
      </ammunition>
      <software>
        <software ware="software_dockmk1"/>
        <software ware="software_flightassistmk1"/>
        <software ware="software_scannerlongrangemk2"/>
        <software ware="software_scannerobjectmk2"/>
        <software ware="software_targetmk1"/>
      </software>
      <virtualmacros>
        <thruster macro="thruster_gen_s_allround_01_mk2_macro"/>
      </virtualmacros>
    </loadout>
    <!-- #184: a YT-1300 (M) with a KX20 forward laser and its two AG-2G turrets, and the same
         without the turrets to compare its DPS with. No loadout of SWI's own either. -->
    <loadout id="apirateslife_test_yt1300_turrets" macro="yt1300_01_a_macro">
      <macros>
        <engine macro="engine_yt_macro" path="../con_engine_01"/>
        <weapon macro="weapon_kx20_m_laser_macro" path="../con_weapon_01"/>
        <turret macro="turret_m_ag2g_macro" path="../con_turret_01"/>
        <turret macro="turret_m_ag2g_macro" path="../con_turret_02"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_01"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_02"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_03"/>
        <shield macro="shield_s_novaldex45_macro" path="../con_shield_04"/>
      </macros>
      <ammunition>
        <ammunition macro="countermeasure_flares_01_macro" exact="8"/>
