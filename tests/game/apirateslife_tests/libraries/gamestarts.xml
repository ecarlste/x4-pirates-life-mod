<?xml version="1.0" encoding="utf-8"?>
<!-- The test gamestart: the same quiet start every run, on SWI's one-sector showcase galaxy
     (sws_galaxy_macro: one cluster, one sector, one empty zone; SWI's maps/swshowcase/), where SWI's
     own showcase and battle starts run. Far quicker to build than swi_galaxy_macro. The same start
     as the SWI bounty hunter's game tests (x4-swi-bounty-hunter, tests/game/swibh_tests).

     God off: no stations. Jobs off: no NPC traffic, so every run starts the same and each test
     spawns what it needs in player.sector. The Empire, the tests' NPC faction, is pinned neutral to
     the player, so its ships neither attack nor stop SETA until a test makes them.

     The player is the Bankrupt Bounty Hunter's character and ship (x4ep1_sw_bhg, SWI
     libraries/gamestarts.xml): character_player_pirate_gamestart1_macro (vanilla Tides of Avarice)
     in SWI's fortitude_macro. SETA in the inventory, so tests can speed up time. nosave keeps test
     games out of the save list. Group 9 is SWI's "utility" group (SWI's gamestarts replace
     vanilla's groups), so it can also be started by hand from the New Game menu for debugging a
     test. Loads after SWI's <replace sel="//gamestarts"> (content.xml's dependency on SWI). -->
<diff>
  <add sel="/gamestarts">
    <gamestart id="apirateslife_test" name="A Pirate's Life: game tests" description="Automated test scenarios for A Pirate's Life. Dev only." image="gamestart_bhg" group="9" tags="nosave">
      <!-- Where SWI's showcase starts put the player (sws_showcase, SWI gamestarts.xml) -->
      <location galaxy="sws_galaxy_macro" sector="sws_clustercoruscant_sector001_macro">
        <position x="-1000" y="0" z="-8000"/>
      </location>
      <player macro="character_player_pirate_gamestart1_macro" money="10000" name="APL Test">
        <ship macro="fortitude_macro">
          <loadout>
            <macros>
              <engine macro="engine_incomh_macro" path="../con_engine_01"/>
              <engine macro="engine_incomh_macro" path="../con_engine_02"/>
              <weapon macro="weapon_ix4_s_laser_macro" path="../con_weapon_01"/>
              <weapon macro="weapon_ix4_s_laser_macro" path="../con_weapon_02"/>
              <shield macro="shield_s_p12_macro" path="../con_shield_01"/>
              <shield macro="shield_s_p12_macro" path="../con_shield_02"/>
              <shield macro="shield_s_p12_macro" path="../con_shield_03"/>
              <shield macro="shield_s_p12_macro" path="../con_shield_04"/>
            </macros>
            <software>
              <software ware="software_dockmk2"/>
              <software ware="software_flightassistmk1"/>
              <software ware="software_scannerlongrangemk1"/>
              <software ware="software_scannerobjectmk1"/>
              <software ware="software_targetmk1"/>
            </software>
            <virtualmacros>
              <thruster macro="thruster_gen_s_combat_01_mk1_macro"/>
            </virtualmacros>
          </loadout>
        </ship>
        <inventory>
          <!-- SETA, so tests can speed up time (toggle_timewarp needs it in the inventory) -->
          <ware ware="inv_timewarp" amount="1"/>
        </inventory>
      </player>
      <universe ventures="false" visitors="false">
        <factions>
          <relations>
            <relation faction="galempire" otherfaction="player" relation="0"/>
          </relations>
        </factions>
        <jobs enabled="false"/>
        <god enabled="false"/>
      </universe>
    </gamestart>
  </add>
</diff>
