<?xml version="1.0" encoding="utf-8"?>
<!-- The test gamestart: the same quiet start every run. The player sits in a scout in the docking
     tutorial's one-sector galaxy, next to its Argon wharf (no god, so no other stations; no jobs, so
     no traffic), and each test spawns what it needs. The wharf is there because stations spawned
     at runtime (create_station) only let their own faction dock, while map-placed ones let the
     player's ships dock too: the booty tests give it to Vigor (docs/specs/booty.md). Also
     selectable by hand from the "New game" menu for debugging a test. -->
<diff>
  <add sel="/gamestarts">
    <gamestart id="apirateslife_test" name="A Pirate's Life: game tests" description="Automated test scenarios for A Pirate's Life. Dev only." image="gamestart_2" group="100" tags="nosave">
      <!-- A tutorial's one-sector galaxy: X4 builds it far faster than the full universe. Where the
           docking tutorial starts (vanilla libraries/gamestarts.xml, tutorial_docking). -->
      <location galaxy="basegame_map_tutorial_default_wharf_galaxy_macro" sector="basegame_map_tutorial_default_wharf_cluster_001_sector_001_macro">
        <position x="82000" y="80" z="64500"/>
      </location>
      <player macro="character_player_tutorial_macro" money="10000">
        <ship macro="ship_arg_s_scout_01_a_macro">
          <loadout>
            <macros>
              <engine macro="engine_arg_s_travel_01_mk2_macro" path="../con_engine_01"/>
              <engine macro="engine_arg_s_travel_01_mk2_macro" path="../con_engine_02"/>
              <shield macro="shield_arg_s_standard_01_mk1_macro" path="../con_shield_01" optional="1"/>
            </macros>
            <virtualmacros>
              <thruster macro="thruster_gen_s_allround_01_mk1_macro"/>
            </virtualmacros>
          </loadout>
        </ship>
        <inventory>
          <!-- SETA, so tests can speed up time (toggle_timewarp needs it in the inventory) -->
          <ware ware="inv_timewarp" amount="1"/>
        </inventory>
      </player>
      <universe>
        <jobs enabled="false"/>
        <god enabled="false"/>
      </universe>
    </gamestart>
  </add>
</diff>
