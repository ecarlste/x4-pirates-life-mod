<?xml version="1.0" encoding="utf-8"?>
<!-- Dev-only test extension for A Pirate's Life: never shipped (not in deploy.include). The game
     test runner (tools/run-game-tests.ps1) installs it for a run and removes it afterwards. With it
     installed, X4 starts the "apirateslife_test" gamestart straight from the main menu, runs the
     tests in md/apirateslife_tests.xml and quits. See docs/research/automated-game-testing.md.

     It depends on X4 8.00 and SWI so it loads after SWI: SWI's libraries/gamestarts.xml does
     <replace sel="//gamestarts">, which would wipe a gamestart added before it. SWI's own
     content.xml has enabled="0", so the test profile's content.xml must switch SWI on (the
     runner's -PrepareProfile does), or this extension is off too and nothing starts. -->
<content id="apirateslife_tests" name="A Pirate's Life: game tests" description="Automated in-game tests for A Pirate's Life. Dev only: starts a test game automatically." author="Erik S. Carlsten" version="100" date="2026-11-11" save="false" enabled="true">
  <dependency version="800"/>
  <dependency id="SW Interworlds" name="SW Interworlds"/>
  <dependency id="apirateslife" name="A Pirate's Life"/>
  <dependency id="ego_dlc_pirate" name="Tides of Avarice"/>
</content>
