<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only diff patch for the game's md/notifications.xml (applied after the mod's own patch).
     The game's PlayerOwnedShipAttacks already has a $testcheat switch that skips the bail gates
     and cooldown and makes the roll 100%. This turns it on while a test sets
     global.$APiratesLifeTest_ForceBail, so bail scenarios are deterministic. -->
<diff>
  <add sel="//cue[@name='PlayerOwnedShipAttacks']//set_value[@name='$targetpilotskill'][@exact='0']" pos="after">
    <do_if value="@global.$APiratesLifeTest_ForceBail">
      <set_value name="$testcheat" exact="true"/>
    </do_if>
  </add>

  <!-- While a bail is forced, record the roll around our bail hook in
       global.$APiratesLifeTest_Roll = table[$target, $before, $after, $swi]: the chance the game
       worked out, the chance it rolls at, and whether this is SWI's Enhanced Bailing block (only
       SWI's sets $pilotmorale). The second insert lands between the hook and the roll. -->
  <add sel="//cue[@name='PlayerOwnedShipAttacks']//run_actions[@ref='md.APiratesLife_Bail.AdjustEjectChance']" pos="before">
    <do_if value="@global.$APiratesLifeTest_ForceBail">
      <set_value name="global.$APiratesLifeTest_Roll" exact="table[$target = $target, $before = $ejectchance, $swi = $pilotmorale?]"/>
    </do_if>
  </add>
  <add sel="//cue[@name='PlayerOwnedShipAttacks']//do_if[@chance='if not $testcheat? then $ejectchance else 100']" pos="before">
    <do_if value="@global.$APiratesLifeTest_ForceBail and @global.$APiratesLifeTest_Roll">
      <set_value name="global.$APiratesLifeTest_Roll.$after" exact="$ejectchance"/>
    </do_if>
  </add>

  <!-- While a test sets global.$APiratesLifeTest_BailCrew, a bail takes that many crew (0 too): a
       partial bail when the ship has more. SWI's Enhanced Bailing block only (its pilot-bail
       check). -->
  <add sel="//cue[@name='PlayerOwnedShipAttacks']//do_if[@value='($numcrewbailing ge $target.people.count) and not $target.isplayerowned']" pos="before">
    <do_if value="global.$APiratesLifeTest_BailCrew?">
      <set_value name="$numcrewbailing" exact="global.$APiratesLifeTest_BailCrew"/>
    </do_if>
  </add>
</diff>
