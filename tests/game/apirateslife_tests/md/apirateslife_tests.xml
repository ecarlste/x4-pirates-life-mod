<?xml version="1.0" encoding="utf-8"?>
<!-- In-game tests for A Pirate's Life. Runs only in the "apirateslife_test" gamestart
     (libraries/gamestarts.xml), one test at a time, then quits the game.

     Every line the runner reads starts with "[apirateslife-test]":
       RUN START <n> tests
       PASS <name>: <detail>
       FAIL <name>: <detail>
       DONE passed=<n> failed=<n>

     Adding a test: a root cue named after it that fires on event_cue_signalled, sets things up,
     and signals Report exactly once (from a result cue or a timeout cue) with
     table[$name, $ok, $detail]. Then add it to $Tests in Run. Set any mod setting the test relies
     on, so settings overridden at deploy time can't change its outcome. -->
<mdscript name="APiratesLife_Tests" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Run">
      <conditions>
        <event_cue_signalled cue="md.Setup.GameStart"/>
        <check_value value="player.module == 'apirateslife_test'"/>
      </conditions>
      <!-- No delay here: X4 activates sub-cues as soon as these conditions are met, before a
           delay would end, so Begin could run before these variables exist -->
      <actions>
        <!-- Set to false to keep the game open after the run, e.g. to look around after a failure -->
        <set_value name="$QuitWhenDone" exact="true"/>
        <set_value name="$Tests" exact="[EjectChanceDoubled, PilotBailIntact, PilotBailVanillaWhenOff, ClaimIntact, ClaimVanillaWhenOff, CaptureWingFullChance, CaptureStartAndDestroyed, CaptureAbandoned, CaptureEscapeWaitsForEngagement, CaptureEscaped, CaptureWingHoldsFire]"/>
        <set_value name="$Index" exact="0"/>
        <set_value name="$Passed" exact="0"/>
        <set_value name="$Failed" exact="0"/>
      </actions>
      <cues>
        <cue name="Begin">
          <!-- Let the game settle after loading -->
          <delay exact="5s"/>
          <actions>
            <debug_text text="'[apirateslife-test] RUN START %s tests'.[$Tests.count]" filter="general"/>
            <!-- SETA: up to 6x game time, for tests that wait on travel. Needs SETA in the inventory
                 (the gamestart provides it) and no enemies nearby. The factor is game time per
                 real second. -->
            <toggle_timewarp/>
            <set_timewarp_factor factor="6s"/>
            <signal_cue cue="NextTest"/>
          </actions>
        </cue>

        <!-- SETA drops whenever something interrupts it (a help message, a wingman's comm call, an
             enemy nearby); switch it back on once the game allows it again -->
        <cue name="KeepSeta" instantiate="true" checkinterval="2s">
          <conditions>
            <check_value value="Begin.state == cuestate.complete"/>
            <check_value value="not player.timewarp.active and player.timewarp.available"/>
          </conditions>
          <actions>
            <toggle_timewarp/>
            <set_timewarp_factor factor="6s"/>
            <debug_text text="'[apirateslife-test] SETA was off; switched back on (now active: %s)'.[player.timewarp.active]"/>
          </actions>
        </cue>

        <cue name="NextTest" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="$Index" operation="add"/>
            <do_if value="$Index le $Tests.count">
              <signal_cue cue="$Tests.{$Index}"/>
            </do_if>
            <do_else>
              <debug_text text="'[apirateslife-test] DONE passed=%s failed=%s'.[$Passed, $Failed]" filter="general"/>
              <do_if value="$QuitWhenDone">
                <signal_cue cue="Quit"/>
              </do_if>
            </do_else>
          </actions>
        </cue>

        <!-- Each test signals this once, with table[$name, $ok, $detail] -->
        <cue name="Report" instantiate="true">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <do_if value="event.param.$ok">
              <set_value name="$Passed" operation="add"/>
              <debug_text text="'[apirateslife-test] PASS %s: %s'.[event.param.$name, event.param.$detail]" filter="general"/>
            </do_if>
            <do_else>
              <set_value name="$Failed" operation="add"/>
              <debug_text text="'[apirateslife-test] FAIL %s: %s'.[event.param.$name, event.param.$detail]" filter="general"/>
            </do_else>
            <signal_cue cue="NextTest"/>
          </actions>
        </cue>

        <cue name="Quit">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <!-- Give the log a moment to flush -->
          <delay exact="2s"/>
          <actions>
            <quit_to_desktop/>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- The bail hook doubles vanilla's final eject chance, capped at 100. A plain library call, no
         scenario needed. -->
    <cue name="EjectChanceDoubled">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Cases" exact="[[0, 0], [10, 20], [30, 60], [50, 100], [70, 100]]"/>
        <set_value name="$Problems" exact="''"/>
        <do_for_each name="$Case" in="$Cases">
          <run_actions ref="md.APiratesLife_Bail.AdjustEjectChance" result="$Got">
            <param name="EjectChance" value="$Case.{1}"/>
            <param name="Attacker" value="null"/>
            <param name="Target" value="null"/>
          </run_actions>
          <do_if value="$Got != $Case.{2}">
            <set_value name="$Problems" exact="$Problems + ' %s gave %s, expected %s;'.[$Case.{1}, $Got, $Case.{2}]"/>
          </do_if>
        </do_for_each>
        <signal_cue_instantly cue="Report" param="table[$name = 'eject_chance_doubled', $ok = ($Problems == ''), $detail = (if $Problems == '' then '%s cases'.[$Cases.count] else $Problems)]"/>
      </actions>
    </cue>

    <!-- ===== Helpers ===== -->

    <!-- A player-owned fighter and a crewless Argon fighter at full hull, 2-3 km from the player.
         With no crew, the first bail takes the pilot and leaves the ship ownerless. Returns
         table[$attacker, $target]. -->
    <library name="SpawnBailPair" purpose="run_actions">
      <actions>
        <create_ship name="$Attacker" macro="ship_arg_s_fighter_01_a_macro" sector="player.sector">
          <owner exact="faction.player" overridenpc="true"/>
          <loadout>
            <level exact="0.5"/>
          </loadout>
          <pilot>
            <select faction="faction.argon" tags="tag.aipilot"/>
          </pilot>
          <safepos object="player.occupiedship" z="2km" allowyaxis="true"/>
        </create_ship>
        <create_ship name="$Target" macro="ship_arg_s_fighter_01_a_macro" sector="player.sector" capturable="true">
          <owner exact="faction.argon" overridenpc="true"/>
          <loadout>
            <level exact="1.0"/>
          </loadout>
          <people>
            <fillpercent exact="0"/>
          </people>
          <pilot>
            <select faction="faction.argon" tags="tag.aipilot"/>
          </pilot>
          <safepos object="player.occupiedship" z="3km" allowyaxis="true"/>
        </create_ship>
        <create_order id="'Wait'" object="$Target" default="true">
          <param name="noattackresponse" value="true"/>
        </create_order>
        <return value="table[$attacker = $Attacker, $target = $Target]"/>
      </actions>
    </library>

    <!-- An ownerless, crewless fighter and a player-owned frigate with marines, set to claim
         abandoned ships, 2-3 km from the player (vanilla aiscripts/interrupt.foundabandonedship.xml
         and move.claim.xml do the rest). The player is nearby, so claims run at the "visible"
         attention level. Returns table[$claimer, $target]. -->
    <library name="SpawnClaimPair" purpose="run_actions">
      <actions>
        <create_ship name="$Target" macro="ship_arg_s_fighter_01_a_macro" sector="player.sector" capturable="true">
          <owner exact="faction.ownerless" overridenpc="true"/>
          <loadout>
            <level exact="1.0"/>
          </loadout>
          <people>
            <fillpercent exact="0"/>
          </people>
          <pilot actor="null"/>
          <safepos object="player.occupiedship" x="2km" allowyaxis="true"/>
        </create_ship>
        <create_ship name="$Claimer" macro="ship_arg_m_frigate_01_a_macro" sector="player.sector">
          <owner exact="faction.player" overridenpc="true"/>
          <loadout>
            <level exact="0.5"/>
          </loadout>
          <pilot>
            <select faction="faction.argon" tags="tag.aipilot"/>
          </pilot>
          <!-- Vanilla claim damage is (100 - marine skill)%, so any marine short of perfect damages the ship -->
          <people>
            <person role="marine" weight="100">
              <select faction="faction.argon" tags="tag.marine"/>
            </person>
          </people>
          <safepos object="player.occupiedship" x="3km" allowyaxis="true"/>
        </create_ship>
        <!-- The abandoned-ship interrupt needs a non-priority order to interrupt -->
        <create_order id="'Wait'" object="$Claimer" default="true"/>
        <set_object_signal_response object="$Claimer" signal="'foundabandonedship'" response="'claim'"/>
        <set_object_hull object="$Target" exact="100"/>
        <return value="table[$claimer = $Claimer, $target = $Target]"/>
      </actions>
    </library>

    <!-- Weapons, turrets and shield generators still working on a ship -->
    <library name="EquipmentCount" purpose="run_actions">
      <params>
        <param name="Ship"/>
      </params>
      <actions>
        <return value="$Ship.weapons.operational.count + $Ship.turrets.operational.count + $Ship.shields.operational.count"/>
      </actions>
    </library>

    <!-- Forces a pilot bail and returns what vanilla would damage: table[$skill, $equipment,
         $sabotage], where $sabotage is how many parts a sabotaging pilot destroys (vanilla:
         min(non-mandatory weapons, turrets and shields, pilot skill / 10)). How a ship's AI asks for
         a bail check when attacked (aiscripts/interrupt.attacked.xml), with vanilla's $testcheat
         switched on by this extension's md/notifications.xml patch, so the bail is certain. -->
    <library name="ForceBail" purpose="run_actions">
      <params>
        <param name="Attacker"/>
        <param name="Target"/>
      </params>
      <actions>
        <set_value name="$Skill" exact="$Target.pilot.combinedskill"/>
        <run_actions ref="EquipmentCount" result="$Equipment">
          <param name="Ship" value="$Target"/>
        </run_actions>
        <find_object_component name="$Parts" object="$Target" class="[class.weapon, class.turret, class.shieldgenerator]" multiple="true">
          <match tag="tag.mandatory" negate="true"/>
        </find_object_component>
        <set_value name="global.$APiratesLifeTest_ForceBail" exact="true"/>
        <signal_objects object="player.galaxy" param="$Attacker" param2="$Target" param3="'shouldwebail'"/>
        <return value="table[$skill = $Skill, $equipment = $Equipment, $sabotage = [$Parts.count, $Skill / 10].min]"/>
      </actions>
    </library>

    <!-- ===== Tests ===== -->

    <!-- Intact on eject (the default): our Bailed signal fires with the pilot, the ship becomes
         ownerless, and keeps its full hull and equipment: no pilot hull drop or sabotage. -->
    <cue name="PilotBailIntact">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$APiratesLife_IntactOnEject" exact="1"/>
        <run_actions ref="SpawnBailPair" result="$Pair"/>
      </actions>
      <cues>
        <cue name="PilotBailIntact_Act">
          <delay exact="2s"/>
          <actions>
            <set_object_hull object="$Pair.$target" exact="100"/>
            <run_actions ref="ForceBail" result="$Before">
              <param name="Attacker" value="$Pair.$attacker"/>
              <param name="Target" value="$Pair.$target"/>
            </run_actions>
          </actions>
          <cues>
            <cue name="PilotBailIntact_Bailed">
              <conditions>
                <event_cue_signalled cue="md.APiratesLife_Bail.Bailed"/>
                <check_value value="event.param.$target == $Pair.$target"/>
              </conditions>
              <actions>
                <cancel_cue cue="PilotBailIntact_Timeout"/>
                <remove_value name="global.$APiratesLifeTest_ForceBail"/>
                <set_value name="$PilotBailed" exact="event.param.$pilot"/>
              </actions>
              <cues>
                <!-- Vanilla damages the ship after signalling the bail; check once it's done -->
                <cue name="PilotBailIntact_Check">
                  <delay exact="1s"/>
                  <actions>
                    <set_value name="$Target" exact="$Pair.$target"/>
                    <run_actions ref="EquipmentCount" result="$Equipment">
                      <param name="Ship" value="$Target"/>
                    </run_actions>
                    <set_value name="$Problems" exact="''"/>
                    <do_if value="not $PilotBailed">
                      <set_value name="$Problems" exact="$Problems + ' pilot did not bail;'"/>
                    </do_if>
                    <do_if value="$Target.trueowner != faction.ownerless">
                      <set_value name="$Problems" exact="$Problems + ' owner is %s, not ownerless;'.[$Target.trueowner]"/>
                    </do_if>
                    <do_if value="$Target.hullpercentage lt 99">
                      <set_value name="$Problems" exact="$Problems + ' hull %s%%, expected 100%%;'.[$Target.hullpercentage]"/>
                    </do_if>
                    <do_if value="$Equipment != $Before.$equipment">
                      <set_value name="$Problems" exact="$Problems + ' equipment %s, was %s;'.[$Equipment, $Before.$equipment]"/>
                    </do_if>
                    <!-- Vanilla's damage scales with pilot skill, so a 0-skill pilot proves nothing -->
                    <do_if value="$Before.$skill == 0">
                      <set_value name="$Problems" exact="$Problems + ' pilot skill 0, so vanilla would not have damaged it either;'"/>
                    </do_if>
                    <signal_cue_instantly cue="Report" param="table[$name = 'pilot_bail_intact', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'hull %s%%, %s equipment kept, pilot skill %s'.[$Target.hullpercentage, $Equipment, $Before.$skill] else $Problems)]"/>
                    <destroy_object object="$Pair.$attacker"/>
                    <destroy_object object="$Target"/>
                  </actions>
                </cue>
              </cues>
            </cue>

            <cue name="PilotBailIntact_Timeout">
              <delay exact="30s"/>
              <actions>
                <cancel_cue cue="PilotBailIntact_Bailed"/>
                <remove_value name="global.$APiratesLifeTest_ForceBail"/>
                <signal_cue_instantly cue="Report" param="table[$name = 'pilot_bail_intact', $ok = false, $detail = 'no Bailed signal within 30s']"/>
                <destroy_object object="$Pair.$attacker"/>
                <destroy_object object="$Pair.$target"/>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!-- Intact on eject off: vanilla damage is back. The hull drops to about (100 - pilot skill)%
         and the pilot destroys exactly the number of parts ForceBail predicts. -->
    <cue name="PilotBailVanillaWhenOff">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$APiratesLife_IntactOnEject" exact="0"/>
        <run_actions ref="SpawnBailPair" result="$Pair"/>
      </actions>
      <cues>
        <cue name="PilotBailVanillaWhenOff_Act">
          <delay exact="2s"/>
          <actions>
            <set_object_hull object="$Pair.$target" exact="100"/>
            <run_actions ref="ForceBail" result="$Before">
              <param name="Attacker" value="$Pair.$attacker"/>
              <param name="Target" value="$Pair.$target"/>
            </run_actions>
          </actions>
          <cues>
            <cue name="PilotBailVanillaWhenOff_Bailed">
              <conditions>
                <event_cue_signalled cue="md.APiratesLife_Bail.Bailed"/>
                <check_value value="event.param.$target == $Pair.$target"/>
              </conditions>
              <actions>
                <cancel_cue cue="PilotBailVanillaWhenOff_Timeout"/>
                <remove_value name="global.$APiratesLifeTest_ForceBail"/>
              </actions>
              <cues>
                <cue name="PilotBailVanillaWhenOff_Check">
                  <delay exact="1s"/>
                  <actions>
                    <set_value name="$Target" exact="$Pair.$target"/>
                    <set_value name="$Skill" exact="$Before.$skill"/>
                    <set_value name="$Problems" exact="''"/>
                    <!-- A 100-skill pilot scuttles the ship and a 0-skill one does no damage, so
                         only skills in between prove anything -->
                    <do_if value="$Skill le 0 or $Skill ge 100">
                      <set_value name="$Problems" exact="' pilot skill %s, so vanilla damage is not measurable;'.[$Skill]"/>
                    </do_if>
                    <do_elseif value="not $Target.exists">
                      <set_value name="$Problems" exact="' ship was destroyed;'"/>
                    </do_elseif>
                    <do_else>
                      <!-- Vanilla sets the hull to between max(100 - skill, 5) and max(100 - skill, 10) -->
                      <set_value name="$Expected" exact="100 - $Skill"/>
                      <do_if value="$Target.hullpercentage gt [$Expected, 10].max + 1 or $Target.hullpercentage lt [$Expected, 5].max - 1">
                        <set_value name="$Problems" exact="$Problems + ' hull %s%%, expected about %s%%;'.[$Target.hullpercentage, $Expected]"/>
                      </do_if>
                      <run_actions ref="EquipmentCount" result="$Equipment">
                        <param name="Ship" value="$Target"/>
                      </run_actions>
                      <do_if value="$Before.$equipment - $Equipment != $Before.$sabotage">
                        <set_value name="$Problems" exact="$Problems + ' %s parts lost, expected %s;'.[$Before.$equipment - $Equipment, $Before.$sabotage]"/>
                      </do_if>
                    </do_else>
                    <signal_cue_instantly cue="Report" param="table[$name = 'pilot_bail_vanilla_when_off', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'hull %s%%, %s parts sabotaged, pilot skill %s'.[$Target.hullpercentage, $Before.$sabotage, $Skill] else $Problems)]"/>
                    <destroy_object object="$Pair.$attacker"/>
                    <do_if value="$Target.exists">
                      <destroy_object object="$Target"/>
                    </do_if>
                  </actions>
                </cue>
              </cues>
            </cue>

            <cue name="PilotBailVanillaWhenOff_Timeout">
              <delay exact="30s"/>
              <actions>
                <cancel_cue cue="PilotBailVanillaWhenOff_Bailed"/>
                <remove_value name="global.$APiratesLifeTest_ForceBail"/>
                <signal_cue_instantly cue="Report" param="table[$name = 'pilot_bail_vanilla_when_off', $ok = false, $detail = 'no Bailed signal within 30s']"/>
                <destroy_object object="$Pair.$attacker"/>
                <destroy_object object="$Pair.$target"/>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!-- Intact on claim (the default): the ownerless fighter becomes the player's with its full
         hull and equipment: no claim damage. -->
    <cue name="ClaimIntact">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$APiratesLife_IntactOnClaim" exact="1"/>
        <run_actions ref="SpawnClaimPair" result="$Pair"/>
        <run_actions ref="EquipmentCount" result="$Before">
          <param name="Ship" value="$Pair.$target"/>
        </run_actions>
      </actions>
      <cues>
        <cue name="ClaimIntact_Claimed">
          <conditions>
            <event_object_changed_true_owner object="$Pair.$target"/>
            <check_value value="$Pair.$target.trueowner == faction.player"/>
          </conditions>
          <actions>
            <cancel_cue cue="ClaimIntact_Timeout"/>
          </actions>
          <cues>
            <!-- move.claim damages the ship about 2s after claiming it; check after that -->
            <cue name="ClaimIntact_Check">
              <delay exact="5s"/>
              <actions>
                <set_value name="$Target" exact="$Pair.$target"/>
                <run_actions ref="EquipmentCount" result="$Equipment">
                  <param name="Ship" value="$Target"/>
                </run_actions>
                <set_value name="$Problems" exact="''"/>
                <do_if value="$Target.hullpercentage lt 99">
                  <set_value name="$Problems" exact="$Problems + ' hull %s%%, expected 100%%;'.[$Target.hullpercentage]"/>
                </do_if>
                <do_if value="$Equipment != $Before">
                  <set_value name="$Problems" exact="$Problems + ' equipment %s, was %s;'.[$Equipment, $Before]"/>
                </do_if>
                <signal_cue_instantly cue="Report" param="table[$name = 'claim_intact', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'hull %s%%, %s equipment kept'.[$Target.hullpercentage, $Equipment] else $Problems)]"/>
                <destroy_object object="$Pair.$claimer"/>
                <destroy_object object="$Target"/>
              </actions>
            </cue>
          </cues>
        </cue>

        <cue name="ClaimIntact_Timeout">
          <delay exact="180s"/>
          <actions>
            <cancel_cue cue="ClaimIntact_Claimed"/>
            <signal_cue_instantly cue="Report" param="table[$name = 'claim_intact', $ok = false, $detail = 'not claimed within 180s (owner: %s)'.[@$Pair.$target.trueowner]]"/>
            <destroy_object object="$Pair.$claimer"/>
            <destroy_object object="$Pair.$target"/>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- Intact on claim off: vanilla claim damage is back. The hull drops to max(marine skill, 70)%;
         vanilla destroys each part only by chance, so equipment isn't checked. -->
    <cue name="ClaimVanillaWhenOff">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$APiratesLife_IntactOnClaim" exact="0"/>
        <run_actions ref="SpawnClaimPair" result="$Pair"/>
      </actions>
      <cues>
        <cue name="ClaimVanillaWhenOff_Claimed">
          <conditions>
            <event_object_changed_true_owner object="$Pair.$target"/>
            <check_value value="$Pair.$target.trueowner == faction.player"/>
          </conditions>
          <actions>
            <cancel_cue cue="ClaimVanillaWhenOff_Timeout"/>
          </actions>
          <cues>
            <cue name="ClaimVanillaWhenOff_Check">
              <delay exact="5s"/>
              <actions>
                <set_value name="$Target" exact="$Pair.$target"/>
                <set_value name="$Problems" exact="''"/>
                <!-- Only a perfect marine (skill 100) would leave the hull at 100% -->
                <do_if value="$Target.hullpercentage ge 99 or $Target.hullpercentage lt 69">
                  <set_value name="$Problems" exact="' hull %s%%, expected 70-99%%;'.[$Target.hullpercentage]"/>
                </do_if>
                <signal_cue_instantly cue="Report" param="table[$name = 'claim_vanilla_when_off', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'hull %s%%'.[$Target.hullpercentage] else $Problems)]"/>
                <destroy_object object="$Pair.$claimer"/>
                <destroy_object object="$Target"/>
              </actions>
            </cue>
          </cues>
        </cue>

        <cue name="ClaimVanillaWhenOff_Timeout">
          <delay exact="180s"/>
          <actions>
            <cancel_cue cue="ClaimVanillaWhenOff_Claimed"/>
            <signal_cue_instantly cue="Report" param="table[$name = 'claim_vanilla_when_off', $ok = false, $detail = 'not claimed within 180s (owner: %s)'.[@$Pair.$target.trueowner]]"/>
            <destroy_object object="$Pair.$claimer"/>
            <destroy_object object="$Pair.$target"/>
          </actions>
        </cue>
      </cues>
    </cue>
    <!-- ===== Capture operations (docs/specs/capture-operation.md) ===== -->

    <!-- The bail hook undoes vanilla's quarter chance for wingmen in the target's operation (x4, then
         our x2), only for members and only while the setting is on. A fake operation on the target
         is enough; no fighting needed. -->
    <cue name="CaptureWingFullChance">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <run_actions ref="SpawnBailPair" result="$Pair"/>
        <set_value name="$Attacker" exact="$Pair.$attacker"/>
        <set_value name="$Target" exact="$Pair.$target"/>
        <!-- [members, setting, vanilla chance, expected] -->
        <do_if value="not global.$APiratesLife_CaptureOps?">
          <set_value name="global.$APiratesLife_CaptureOps" exact="table[]"/>
        </do_if>
        <set_value name="$Cases" exact="[[[$Attacker], 1, 5, 40], [[$Attacker], 1, 20, 100], [[$Attacker], 0, 5, 10], [[], 1, 5, 10]]"/>
        <set_value name="$Problems" exact="''"/>
        <do_for_each name="$Case" in="$Cases">
          <set_value name="$Op" exact="table[$leader = player.occupiedship, $members = $Case.{1}, $op = null, $lastchance = null]"/>
          <set_value name="global.$APiratesLife_CaptureOps.{$Target}" exact="$Op"/>
          <set_value name="global.$APiratesLife_CaptureWingFullChance" exact="$Case.{2}"/>
          <run_actions ref="md.APiratesLife_Bail.AdjustEjectChance" result="$Got">
            <param name="EjectChance" value="$Case.{3}"/>
            <param name="Attacker" value="$Attacker"/>
            <param name="Target" value="$Target"/>
          </run_actions>
          <do_if value="$Got != $Case.{4}">
            <set_value name="$Problems" exact="$Problems + ' %s member(s), setting %s: %s gave %s, expected %s;'.[$Case.{1}.count, $Case.{2}, $Case.{3}, $Got, $Case.{4}]"/>
          </do_if>
          <do_if value="$Op.$lastchance != $Got">
            <set_value name="$Problems" exact="$Problems + ' last chance not recorded;'"/>
          </do_if>
        </do_for_each>
        <set_value name="global.$APiratesLife_CaptureWingFullChance" exact="1"/>
        <remove_value name="global.$APiratesLife_CaptureOps.{$Target}"/>
        <signal_cue_instantly cue="Report" param="table[$name = 'capture_wing_full_chance', $ok = ($Problems == ''), $detail = (if $Problems == '' then '%s cases'.[$Cases.count] else $Problems)]"/>
        <destroy_object object="$Attacker"/>
        <destroy_object object="$Target"/>
      </actions>
    </cue>

    <!-- Start accepts a fresh target, sets its state and refuses player-owned ships and a second
         operation; destroying the target ends the operation as "destroyed" and clears the state. -->
    <cue name="CaptureStartAndDestroyed">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <run_actions ref="SpawnBailPair" result="$Pair"/>
        <set_value name="$Target" exact="$Pair.$target"/>
        <set_value name="$Problems" exact="''"/>
        <run_actions ref="md.APiratesLife_Capture.CanStart" result="$Ok">
          <param name="Target" value="$Pair.$attacker"/>
        </run_actions>
        <do_if value="$Ok">
          <set_value name="$Problems" exact="$Problems + ' accepted a player-owned ship;'"/>
        </do_if>
        <run_actions ref="md.APiratesLife_Capture.Start" result="$Ok">
          <param name="Target" value="$Target"/>
        </run_actions>
        <do_if value="not $Ok">
          <set_value name="$Problems" exact="$Problems + ' refused a capturable fighter;'"/>
        </do_if>
        <do_if value="not @global.$APiratesLife_CaptureOps.{$Target}">
          <set_value name="$Problems" exact="$Problems + ' no operation state on the target;'"/>
        </do_if>
        <run_actions ref="md.APiratesLife_Capture.Start" result="$Ok">
          <param name="Target" value="$Target"/>
        </run_actions>
        <do_if value="$Ok">
          <set_value name="$Problems" exact="$Problems + ' started a second operation;'"/>
        </do_if>
        <destroy_object object="$Target"/>
      </actions>
      <cues>
        <cue name="CaptureStartAndDestroyed_Ended">
          <conditions>
            <event_cue_signalled cue="md.APiratesLife_Capture.Ended"/>
            <check_value value="event.param.$target == $Target"/>
          </conditions>
          <actions>
            <cancel_cue cue="CaptureStartAndDestroyed_Timeout"/>
            <do_if value="event.param.$outcome != 'destroyed'">
              <set_value name="$Problems" exact="$Problems + ' ended as %s, expected destroyed;'.[event.param.$outcome]"/>
            </do_if>
            <signal_cue_instantly cue="Report" param="table[$name = 'capture_start_and_destroyed', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'started, refused twice, ended as destroyed' else $Problems)]"/>
            <destroy_object object="$Pair.$attacker"/>
          </actions>
        </cue>
        <cue name="CaptureStartAndDestroyed_Timeout">
          <delay exact="10s"/>
          <actions>
            <cancel_cue cue="CaptureStartAndDestroyed_Ended"/>
            <signal_cue_instantly cue="Report" param="table[$name = 'capture_start_and_destroyed', $ok = false, $detail = $Problems + ' operation did not end within 10s of the target being destroyed']"/>
            <destroy_object object="$Pair.$attacker"/>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- A pilot bail during an operation ends it as "abandoned", clears the target's state, and an
         ownerless ship can't start a new one -->
    <cue name="CaptureAbandoned">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$APiratesLife_IntactOnEject" exact="1"/>
        <run_actions ref="SpawnBailPair" result="$Pair"/>
        <set_value name="$Target" exact="$Pair.$target"/>
        <run_actions ref="md.APiratesLife_Capture.Start" result="$Started">
          <param name="Target" value="$Target"/>
        </run_actions>
      </actions>
      <cues>
        <cue name="CaptureAbandoned_Act">
          <delay exact="2s"/>
          <actions>
            <run_actions ref="ForceBail" result="$Before">
              <param name="Attacker" value="$Pair.$attacker"/>
              <param name="Target" value="$Target"/>
            </run_actions>
          </actions>
          <cues>
            <cue name="CaptureAbandoned_Ended">
              <conditions>
                <event_cue_signalled cue="md.APiratesLife_Capture.Ended"/>
                <check_value value="event.param.$target == $Target"/>
              </conditions>
              <actions>
                <cancel_cue cue="CaptureAbandoned_Timeout"/>
                <remove_value name="global.$APiratesLifeTest_ForceBail"/>
                <set_value name="$Problems" exact="''"/>
                <do_if value="not $Started">
                  <set_value name="$Problems" exact="$Problems + ' operation did not start;'"/>
                </do_if>
                <do_if value="event.param.$outcome != 'abandoned'">
                  <set_value name="$Problems" exact="$Problems + ' ended as %s, expected abandoned;'.[event.param.$outcome]"/>
                </do_if>
                <do_if value="@global.$APiratesLife_CaptureOps.{$Target}">
                  <set_value name="$Problems" exact="$Problems + ' operation state left on the target;'"/>
                </do_if>
                <run_actions ref="md.APiratesLife_Capture.CanStart" result="$Ok">
                  <param name="Target" value="$Target"/>
                </run_actions>
                <do_if value="$Ok">
                  <set_value name="$Problems" exact="$Problems + ' accepted an ownerless ship;'"/>
                </do_if>
                <signal_cue_instantly cue="Report" param="table[$name = 'capture_abandoned', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'ended as abandoned, state cleared' else $Problems)]"/>
                <destroy_object object="$Pair.$attacker"/>
                <destroy_object object="$Target"/>
              </actions>
            </cue>
            <cue name="CaptureAbandoned_Timeout">
              <delay exact="30s"/>
              <actions>
                <cancel_cue cue="CaptureAbandoned_Ended"/>
                <remove_value name="global.$APiratesLifeTest_ForceBail"/>
                <signal_cue_instantly cue="Report" param="table[$name = 'capture_abandoned', $ok = false, $detail = 'operation did not end within 30s (owner: %s)'.[@$Target.trueowner]]"/>
                <destroy_object object="$Pair.$attacker"/>
                <destroy_object object="$Target"/>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!-- Hailing from farther than 15 km doesn't start the escape timer: the operation is still
         running 40 s later (the escape rule needs 30 s with nobody close, once someone has been
         close). Found in Erik's save: an operation "escaped" 30 s after a long-range hail. -->
    <cue name="CaptureEscapeWaitsForEngagement">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <run_actions ref="SpawnBailPair" result="$Pair"/>
        <set_value name="$Target" exact="$Pair.$target"/>
        <warp object="$Target" sector="player.sector">
          <safepos object="player.occupiedship" z="20km" allowyaxis="true"/>
        </warp>
        <run_actions ref="md.APiratesLife_Capture.Start" result="$Started">
          <param name="Target" value="$Target"/>
        </run_actions>
      </actions>
      <cues>
        <cue name="CaptureEscapeWaitsForEngagement_Ended">
          <conditions>
            <event_cue_signalled cue="md.APiratesLife_Capture.Ended"/>
            <check_value value="event.param.$target == $Target"/>
          </conditions>
          <actions>
            <cancel_cue cue="CaptureEscapeWaitsForEngagement_Check"/>
            <signal_cue_instantly cue="Report" param="table[$name = 'capture_escape_waits_for_engagement', $ok = false, $detail = 'operation ended as %s before anyone got close'.[event.param.$outcome]]"/>
            <destroy_object object="$Pair.$attacker"/>
            <do_if value="$Target.exists">
              <destroy_object object="$Target"/>
            </do_if>
          </actions>
        </cue>
        <cue name="CaptureEscapeWaitsForEngagement_Check">
          <delay exact="40s"/>
          <actions>
            <cancel_cue cue="CaptureEscapeWaitsForEngagement_Ended"/>
            <set_value name="$Problems" exact="''"/>
            <do_if value="not $Started">
              <set_value name="$Problems" exact="' operation did not start;'"/>
            </do_if>
            <do_elseif value="not @global.$APiratesLife_CaptureOps.{$Target}">
              <set_value name="$Problems" exact="' operation is gone;'"/>
            </do_elseif>
            <signal_cue_instantly cue="Report" param="table[$name = 'capture_escape_waits_for_engagement', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'still running 40 s after starting %s m away'.[(player.occupiedship.distanceto.{$Target})i] else $Problems)]"/>
            <!-- Ends the operation as destroyed -->
            <destroy_object object="$Pair.$attacker"/>
            <destroy_object object="$Target"/>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- Once the player has been close, a target that gets more than 15 km from everyone in the
         operation for 30 s has escaped. Warping it away stands in for a getaway. -->
    <cue name="CaptureEscaped">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <run_actions ref="SpawnBailPair" result="$Pair"/>
        <set_value name="$Target" exact="$Pair.$target"/>
        <run_actions ref="md.APiratesLife_Capture.Start" result="$Started">
          <param name="Target" value="$Target"/>
        </run_actions>
      </actions>
      <cues>
        <!-- The target starts about 3 km away, so the operation counts as engaged within a second -->
        <cue name="CaptureEscaped_Flee">
          <delay exact="3s"/>
          <actions>
            <warp object="$Target" sector="player.sector">
              <safepos object="player.occupiedship" z="25km" allowyaxis="true"/>
            </warp>
            <set_value name="$FledAt" exact="player.age"/>
          </actions>
          <cues>
            <cue name="CaptureEscaped_Ended">
              <conditions>
                <event_cue_signalled cue="md.APiratesLife_Capture.Ended"/>
                <check_value value="event.param.$target == $Target"/>
              </conditions>
              <actions>
                <cancel_cue cue="CaptureEscaped_Timeout"/>
                <set_value name="$Problems" exact="''"/>
                <do_if value="event.param.$outcome != 'escaped'">
                  <set_value name="$Problems" exact="' ended as %s, expected escaped;'.[event.param.$outcome]"/>
                </do_if>
                <do_elseif value="player.age - $FledAt lt 29s">
                  <set_value name="$Problems" exact="' escaped after only %s s;'.[player.age - $FledAt]"/>
                </do_elseif>
                <signal_cue_instantly cue="Report" param="table[$name = 'capture_escaped', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'escaped %s s after getting away'.[(player.age - $FledAt)i] else $Problems)]"/>
                <destroy_object object="$Pair.$attacker"/>
                <do_if value="$Target.exists">
                  <destroy_object object="$Target"/>
                </do_if>
              </actions>
            </cue>
            <cue name="CaptureEscaped_Timeout">
              <delay exact="60s"/>
              <actions>
                <cancel_cue cue="CaptureEscaped_Ended"/>
                <signal_cue_instantly cue="Report" param="table[$name = 'capture_escaped', $ok = false, $detail = 'no escape within 60 s of getting away (operation running: %s)'.[@global.$APiratesLife_CaptureOps.{$Target} != null]]"/>
                <destroy_object object="$Pair.$attacker"/>
                <destroy_object object="$Target"/>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!-- A wingman in an operation really fights: it breaks the target's hull to under 75% (vanilla's
         bail gate), then only takes the shields down, so the hull stays close to 75% and never
         reaches the floor. The target is made uncapturable
         after the start, so no bail ends the fight early. Real combat at the "visible" attention
         level, so it takes a while. -->
    <cue name="CaptureWingHoldsFire">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="global.$APiratesLife_CaptureHoldHull" exact="75"/>
        <set_value name="global.$APiratesLife_CaptureFloorHull" exact="35"/>
        <set_value name="global.$APiratesLife_CaptureDebug" exact="100"/>
        <!-- A fixed loadout from this extension's libraries/loadouts.xml: two pulse lasers and no
             missile launcher. A random loadout made the test a lottery: slow mass drivers barely
             landed a shot and torpedoes one-shot the target. -->
        <create_ship name="$Wingman" macro="ship_arg_s_fighter_01_a_macro" sector="player.sector">
          <owner exact="faction.player" overridenpc="true"/>
          <loadout ref="apirateslife_test_nova_lasers"/>
          <pilot>
            <select faction="faction.argon" tags="tag.aipilot"/>
          </pilot>
          <safepos object="player.occupiedship" x="-1km" allowyaxis="true"/>
        </create_ship>
        <set_object_commander object="$Wingman" commander="player.occupiedship" assignment="assignment.defence"/>
        <create_ship name="$Target" macro="ship_arg_s_fighter_01_a_macro" sector="player.sector" capturable="true">
          <owner exact="faction.argon" overridenpc="true"/>
          <loadout>
            <level exact="1.0"/>
          </loadout>
          <pilot>
            <select faction="faction.argon" tags="tag.aipilot"/>
          </pilot>
          <safepos object="player.occupiedship" z="3km" allowyaxis="true"/>
        </create_ship>
        <create_order id="'Wait'" object="$Target" default="true">
          <param name="noattackresponse" value="true"/>
        </create_order>
        <set_value name="$MinHull" exact="100"/>
        <set_value name="$HeldFor" exact="0"/>
      </actions>
      <cues>
        <cue name="CaptureWingHoldsFire_Start">
          <delay exact="2s"/>
          <actions>
            <run_actions ref="md.APiratesLife_Capture.Start" result="$Started">
              <param name="Target" value="$Target"/>
            </run_actions>
            <set_object_capturable object="$Target" capturable="false"/>
          </actions>
          <cues>
            <cue name="CaptureWingHoldsFire_Watch" checkinterval="1s" instantiate="true">
              <actions>
                <set_value name="$Finished" exact="true"/>
                <set_value name="$Result" exact="''"/>
                <do_if value="not $Target.exists or not $Target.isoperational">
                  <set_value name="$Result" exact="' target destroyed (lowest hull seen %s%%);'.[$MinHull]"/>
                </do_if>
                <do_else>
                  <set_value name="$MinHull" exact="[$MinHull, $Target.hullpercentage].min"/>
                  <debug_text text="'[apirateslife-test] trace: hull %s%%, shields %s%%, wingman %sm away, order %s, may attack %s, enemy %s, guns %s, ready %s, dps %s'.[$Target.hullpercentage, $Target.shieldpercentage, $Wingman.distanceto.{$Target}, @$Wingman.order.id, $Wingman.mayattack.{$Target}, $Wingman.hasrelation.enemy.{$Target}, $Wingman.weapons.operational.count, @$Wingman.weapons.operational.list.{1}.isreadytofire, $Wingman.dps.lasers.all]"/>
                  <do_if value="$Target.hullpercentage lt 35">
                    <set_value name="$Result" exact="' hull %s%%, below the 35%% floor;'.[$Target.hullpercentage]"/>
                  </do_if>
                  <do_else>
                    <set_value name="$Finished" exact="false"/>
                    <do_if value="$Target.hullpercentage lt 75">
                      <set_value name="$HeldFor" operation="add"/>
                      <!-- Inside the bail gate long enough to see that the wing stops there -->
                      <set_value name="$Finished" exact="$HeldFor ge 30"/>
                    </do_if>
                  </do_else>
                </do_else>
                <do_if value="$Finished">
                  <cancel_cue cue="CaptureWingHoldsFire_Timeout"/>
                  <signal_cue_instantly cue="CaptureWingHoldsFire_Done" param="$Result"/>
                </do_if>
              </actions>
            </cue>
            <cue name="CaptureWingHoldsFire_Timeout">
              <delay exact="180s"/>
              <actions>
                <signal_cue_instantly cue="CaptureWingHoldsFire_Done" param="' hull only got to %s%% in 180s, %s s under 75%%;'.[$MinHull, $HeldFor]"/>
              </actions>
            </cue>
            <cue name="CaptureWingHoldsFire_Done">
              <conditions>
                <event_cue_signalled/>
              </conditions>
              <actions>
                <cancel_cue cue="CaptureWingHoldsFire_Watch"/>
                <remove_value name="global.$APiratesLife_CaptureDebug"/>
                <set_value name="$Problems" exact="event.param"/>
                <do_if value="not $Started">
                  <set_value name="$Problems" exact="$Problems + ' operation did not start;'"/>
                </do_if>
                <!-- Wingmen stop once the hull is under 75% and the shields are gone, so only shots
                     already on their way should take it further. 20 points is a generous margin. -->
                <do_if value="$Problems == '' and $MinHull lt 55">
                  <set_value name="$Problems" exact="' lowest hull %s%%, more than 20 points under the 75%% gate;'.[$MinHull]"/>
                </do_if>
                <signal_cue_instantly cue="Report" param="table[$name = 'capture_wing_holds_fire', $ok = ($Problems == ''), $detail = (if $Problems == '' then 'held %s s under 75%%, lowest hull %s%%'.[$HeldFor, $MinHull] else $Problems)]"/>
                <destroy_object object="$Wingman"/>
                <do_if value="$Target.exists">
                  <destroy_object object="$Target"/>
                </do_if>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>
