#!/usr/bin/env bats
# Tests for tools/test-plan-docs.py: the readable test plan generated from the feature files.
# Fixtures (features, game tests, unit tests, output folder) live in a temporary folder.

setup() {
    command -v python3 >/dev/null || skip "python3 is not installed"
    REPO_ROOT="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
    GEN="$REPO_ROOT/tools/test-plan-docs.py"
    T="$BATS_TEST_TMPDIR"
    mkdir -p "$T/features" "$T/lua" "$T/out"
    cat > "$T/tests.xml" <<'XML'
<mdscript><cues>
  <signal_cue_instantly cue="Report" param="table[$name = 'alpha_works', $ok = true, $detail = '']"/>
</cues></mdscript>
XML
    printf 'TestThings = {}\nfunction TestThings:test_beta_rules()\nend\n' > "$T/lua/test_things.lua"
    cat > "$T/features/things.feature" <<'GHERKIN'
# Spec: docs/specs/things.md
Feature: Things
  Things work, and are described
  over two lines.

  @alpha_works
  Scenario: Alpha works
    Given a thing
    Then alpha works

  @test_beta_rules
  Scenario Outline: Beta rules for <n>
    Given <n> things
    Then beta rules

    Examples:
      | n |
      | 1 |

  @manual
  Scenario: Gamma looks right
    Then it looks right

  @pending
  Scenario: Delta, test planned
    Then delta works
GHERKIN
}

gen() { run python3 "$GEN" --features "$T/features" --harness "$T/tests.xml" --units "$T/lua" --out "$T/out" "$@"; }

@test "writes a page per feature, with counts, labels and steps" {
    gen
    [ "$status" -eq 0 ]
    page="$T/out/things.md"
    head -1 "$page" | grep -q "Generated by tools/test-plan-docs.py from tests/game/features/things.feature. Don't edit"
    grep -q '^# Things$' "$page"
    grep -q '^Things work, and are described over two lines.$' "$page"
    grep -q '(../../tests/game/features/things.feature)' "$page" || grep -q 'features/things.feature)' "$page"
    grep -q '^| 1 | 1 | 1 | 1 | \*\*2\*\* |$' "$page"
    # shellcheck disable=SC2016  # the backticks are literal Markdown, not command substitution
    grep -q '^\*\*Automated:\*\* in game `alpha_works`$' "$page"
    # shellcheck disable=SC2016  # the backticks are literal Markdown, not command substitution
    grep -q '^\*\*Automated:\*\* unit test `test_beta_rules`$' "$page"
    grep -q '^- \[ \] \*\*Manual:\*\*' "$page"
    grep -q '^- \[ \] \*\*Pending:\*\*' "$page"
    grep -q '^  Given <n> things$' "$page"
    grep -q '^    | 1 |$' "$page"
}

@test "writes an index with every feature and the totals" {
    gen
    grep -q '^| \[Things\](things.md) | 4 | 1 | 1 | 1 | 1 | \*\*2\*\* |$' "$T/out/README.md"
    grep -q '^| \*\*Total\*\* | 4 | 1 | 1 | 1 | 1 | \*\*2\*\* |$' "$T/out/README.md"
}

@test "--check passes when the pages are current and names stale ones otherwise" {
    gen
    gen --check
    [ "$status" -eq 0 ]
    [[ "$output" == *"up to date (2 pages)"* ]]
    sed -i.bak 's/@pending/@manual/' "$T/features/things.feature" && rm "$T/features/things.feature.bak"
    gen --check
    [ "$status" -eq 1 ]
    [[ "$output" == *"out of date: docs/test-plan/things.md"* ]]
    [[ "$output" == *"out of date: docs/test-plan/README.md"* ]]
    [[ "$output" == *"Run make test-plan"* ]]
}

@test "a new test changes the page: a pending scenario stays pending until retagged, a new tag is labelled" {
    gen
    printf 'TestThings = {}\nfunction TestThings:test_beta_rules()\nend\nfunction TestThings:test_delta_works()\nend\n' > "$T/lua/test_things.lua"
    sed -i.bak 's/@pending/@test_delta_works/' "$T/features/things.feature" && rm "$T/features/things.feature.bak"
    gen
    [[ "$output" == *"Updated 2 of 2 test-plan pages"* ]]
    grep -q '^| 2 | 1 | 1 | 0 | \*\*1\*\* |$' "$T/out/things.md"
}

@test "removes the page of a feature file that's gone" {
    gen
    echo 'old' > "$T/out/gone.md"
    gen --check
    [ "$status" -eq 1 ]
    [[ "$output" == *"no feature file any more: docs/test-plan/gone.md"* ]]
    gen
    [ ! -e "$T/out/gone.md" ]
}

@test "leaves current pages untouched" {
    gen
    gen
    [[ "$output" == *"Updated 0 of 2 test-plan pages"* ]]
}

@test "refuses a test plan the checker can't read" {
    printf 'Feature: Broken\n\n  Scenario: No tag\n    Given nothing\n' > "$T/features/broken.feature"
    gen
    [ "$status" -eq 1 ]
    [[ "$output" == *"scenario has no tag"* ]]
}

@test "the committed docs/test-plan/ is up to date" {
    run python3 "$GEN" --check
    echo "$output"
    [ "$status" -eq 0 ]
}
