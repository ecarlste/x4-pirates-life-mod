<?xml version="1.0" encoding="utf-8"?>
<!-- Bail hook: md/notifications.xml (our diff patch) calls into this script from vanilla's
     PlayerOwnedShipAttacks, the cue that makes every bail decision. See docs/specs/bail-hook.md. -->
<mdscript name="APiratesLife_Bail" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Called just before the game rolls for a bail, with its final chance (after its own
         modifiers; under SWI, the chance its Enhanced Bailing works out, often a fraction).
         Returns the chance the game should roll with: the game's own, unless the target is in a
         capture operation. Then its bail pressure is added, never above CapturePressureCap and
         never below the game's chance: max(chance, min(chance + pressure, cap)). A fresh
         operation has no pressure yet, so its first check rolls at the game's chance, unless its
         pilot has fear from an earlier one. -->
    <library name="AdjustEjectChance" purpose="run_actions">
      <params>
        <param name="EjectChance"/>
        <param name="Attacker"/>
        <param name="Target"/>
      </params>
      <actions>
        <set_value name="$Chance" exact="$EjectChance"/>

        <!-- Capture operations (md/apirateslife_capture.xml) -->
        <set_value name="$Op" exact="null"/>
        <do_if value="$Target">
          <set_value name="$Op" exact="@global.$APiratesLife_CaptureOps.{$Target}"/>
        </do_if>
        <set_value name="$Pressure" exact="0"/>
        <do_if value="$Op">
          <run_actions ref="md.APiratesLife_Capture.Pressure" result="$Pressure">
            <param name="Target" value="$Target"/>
          </run_actions>
          <run_actions ref="md.APiratesLife_Capture.PressureCap" result="$Cap"/>
          <set_value name="$Chance" exact="[$EjectChance, [$EjectChance + $Pressure, $Cap].min].max"/>
          <!-- For the operation's readout -->
          <set_value name="$Op.$lastchance" exact="$Chance"/>
        </do_if>
        <debug_text text="'[apirateslife] bail check: %s (%s) attacking %s (%s): chance %s -> %s (pressure %s)'.[@$Attacker.knownname, @$Attacker.idcode, @$Target.knownname, @$Target.idcode, $EjectChance, $Chance, $Pressure]"/>
        <!-- Every call is an evaluated check, for the capture metrics (md/apirateslife_metrics.xml) -->
        <signal_cue_instantly cue="md.APiratesLife_Metrics.BailChecked" param="table[$attacker = $Attacker, $target = $Target, $chance = $Chance]"/>
        <return value="$Chance"/>
      </actions>
    </library>

    <!-- Signalled by our patch whenever crew bail, with table[$attacker, $target, $crew, $pilot] -->
    <cue name="Bailed" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <debug_text text="'[apirateslife] bailed: %s crew from %s (%s) (attacker %s (%s)), pilot bailed: %s'.[event.param.$crew, @event.param.$target.knownname, @event.param.$target.idcode, @event.param.$attacker.knownname, @event.param.$attacker.idcode, event.param.$pilot]"/>
      </actions>
    </cue>
  </cues>
</mdscript>
