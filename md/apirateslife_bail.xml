<?xml version="1.0" encoding="utf-8"?>
<!-- Bail hook: md/notifications.xml (our diff patch) calls into this script from vanilla's
     PlayerOwnedShipAttacks, the cue that makes every bail decision. See docs/specs/bail-hook.md. -->
<mdscript name="APiratesLife_Bail" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Called just before vanilla rolls for a bail, with its final chance (after its own modifiers).
         Returns the chance vanilla should roll with. -->
    <library name="AdjustEjectChance" purpose="run_actions">
      <params>
        <param name="EjectChance"/>
        <param name="Attacker"/>
        <param name="Target"/>
      </params>
      <actions>
        <set_value name="$Chance" exact="$EjectChance"/>
        <set_value name="$Note" exact="''"/>

        <!-- Capture operations (md/apirateslife_capture.xml): a wingman's hit counts like the
             player's while the player leads the operation in the target's sector, undoing vanilla's
             quarter chance for attackers the player isn't flying -->
        <set_value name="$Op" exact="null"/>
        <do_if value="$Target">
          <set_value name="$Op" exact="@global.$APiratesLife_CaptureOps.{$Target}"/>
        </do_if>
        <do_if value="$Op and $Attacker and $Attacker != player.occupiedship">
          <do_if value="$Op.$members.indexof.{$Attacker} and $Op.$leader == player.occupiedship and player.occupiedship.sector == $Target.sector">
            <do_if value="not (global.$APiratesLife_CaptureWingFullChance? and global.$APiratesLife_CaptureWingFullChance == 0)">
              <set_value name="$Chance" exact="$Chance * 4"/>
              <set_value name="$Note" exact="' (capture wing x4)'"/>
            </do_if>
          </do_if>
        </do_if>

        <!-- Bail rate doubled for now; notoriety and difficulty modifiers will plug in here -->
        <set_value name="$Chance" exact="[($Chance * 2)i, 100].min"/>
        <do_if value="$Op">
          <!-- For the operation's readout -->
          <set_value name="$Op.$lastchance" exact="$Chance"/>
        </do_if>
        <debug_text text="'[apirateslife] bail check: %s attacking %s: chance %s -> %s%s'.[@$Attacker.knownname, @$Target.knownname, $EjectChance, $Chance, $Note]"/>
        <return value="$Chance"/>
      </actions>
    </library>

    <!-- Signalled by our patch whenever crew bail, with table[$attacker, $target, $crew, $pilot] -->
    <cue name="Bailed" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <debug_text text="'[apirateslife] bailed: %s crew from %s (attacker %s), pilot bailed: %s'.[event.param.$crew, @event.param.$target.knownname, @event.param.$attacker.knownname, event.param.$pilot]"/>
      </actions>
    </cue>
  </cues>
</mdscript>
