<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: where each setting's value comes from, and the in-game settings page's MD side.
     See docs/specs/in-game-settings.md.

     Three layers, each filling what the one above leaves empty:
       1. This save's values, chosen in game: global.$APiratesLife_Chosen (keys '$<Name>').
       2. My defaults, a profile-wide set kept by the page's Lua (ui/apirateslife_options.lua);
          copied into a save once (seeding), or when the player loads them there.
       3. The config file, md/apirateslife_config.xml, applied on every game start and load.
     The patches only ever read global.$APiratesLife_<Name>.

     Only the page settings in PageSettings can be chosen in game. The rest (capture hold line and
     floor) are tuning values that follow the config file alone.

     The page talks to this script with AddUITriggeredEvent("APiratesLife_Settings", control, value):
       <Name>, 0 or 1         sets a page setting in this save
       'Reset'                clears this save's values, back to the config file
       'LoadDefaults', list   copies my defaults into this save: [name, value, name, value, ...]
       'LuaLoaded', list      the Lua reporting in after a start or load: [UI Extensions found
                              (0 or 1), then my defaults as name, value pairs]; seeds an unseeded save
     The current values go back to Lua on the player blackboard, player.entity.$APiratesLife_Settings. -->
<mdscript name="APiratesLife_Settings" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="OnLoad" instantiate="true">
      <conditions>
        <check_any>
          <event_cue_signalled cue="md.Setup.GameStart"/>
          <event_game_loaded/>
        </check_any>
      </conditions>
      <actions>
        <set_value name="Lua.$Reported" exact="false"/>
        <run_actions ref="Apply"/>
        <debug_text text="'[apirateslife] settings: applied (intact on eject %s, intact on claim %s, capture hold hull %s, floor hull %s, wing full chance %s; chosen in this save: %s)'.[global.$APiratesLife_IntactOnEject, global.$APiratesLife_IntactOnClaim, global.$APiratesLife_CaptureHoldHull, global.$APiratesLife_CaptureFloorHull, global.$APiratesLife_CaptureWingFullChance, @global.$APiratesLife_Chosen.keys.list]"/>
        <!-- Ask the Lua to report in, in case it loaded before this cue ran -->
        <raise_lua_event name="'APiratesLife.settingsReady'"/>
      </actions>
    </cue>

    <!-- The settings the page can change. Each is 0 or 1. -->
    <library name="PageSettings" purpose="run_actions">
      <actions>
        <return value="['IntactOnEject', 'IntactOnClaim', 'CaptureWingFullChance']"/>
      </actions>
    </library>

    <!-- Applies the config file, then this save's values over it, and mirrors the result to Lua -->
    <library name="Apply" purpose="run_actions">
      <actions>
        <run_actions ref="md.APiratesLife_Config.Defaults"/>
        <run_actions ref="PageSettings" result="$Names"/>
        <set_value name="$Config" exact="table[]"/>
        <set_value name="$Values" exact="table[]"/>
        <do_for_each name="$Name" in="$Names">
          <run_actions ref="GetSetting" result="$Value">
            <param name="Name" value="$Name"/>
          </run_actions>
          <set_value name="$Config.{'$' + $Name}" exact="$Value"/>
          <do_if value="global.$APiratesLife_Chosen? and global.$APiratesLife_Chosen.{'$' + $Name}?">
            <set_value name="$Value" exact="global.$APiratesLife_Chosen.{'$' + $Name}"/>
            <run_actions ref="SetSetting">
              <param name="Name" value="$Name"/>
              <param name="Value" value="$Value"/>
            </run_actions>
          </do_if>
          <set_value name="$Values.{'$' + $Name}" exact="$Value"/>
        </do_for_each>
        <set_value name="player.entity.$APiratesLife_Settings" exact="table[$values = $Values, $config = $Config]"/>
      </actions>
    </library>

    <!-- Chooses a page setting in this save. Returns false (and changes nothing) for a name that
         isn't a page setting or a value that isn't 0 or 1. -->
    <library name="Choose" purpose="run_actions">
      <params>
        <param name="Name"/>
        <param name="Value"/>
      </params>
      <actions>
        <run_actions ref="PageSettings" result="$Names"/>
        <do_if value="typeof $Name != datatype.string or not $Names.indexof.{$Name}">
          <debug_text text="'[apirateslife] settings: ignored unknown or config-only setting %s'.[$Name]"/>
          <return value="false"/>
        </do_if>
        <do_if value="not (typeof $Value).isnumeric or ($Value != 0 and $Value != 1)">
          <debug_text text="'[apirateslife] settings: ignored %s = %s (must be 0 or 1)'.[$Name, $Value]"/>
          <return value="false"/>
        </do_if>
        <do_if value="not global.$APiratesLife_Chosen?">
          <set_value name="global.$APiratesLife_Chosen" exact="table[]"/>
        </do_if>
        <!-- Lua numbers may arrive as floats; store whole numbers like the config does -->
        <set_value name="global.$APiratesLife_Chosen.{'$' + $Name}" exact="if $Value == 1 then 1 else 0"/>
        <return value="true"/>
      </actions>
    </library>

    <!-- Chooses every name, value pair in a flat list [name, value, name, value, ...] -->
    <library name="ChooseList" purpose="run_actions">
      <params>
        <param name="List"/>
        <param name="Start" default="1"/>
      </params>
      <actions>
        <do_if value="typeof $List == datatype.list and $List.count gt $Start">
          <do_all exact="($List.count - $Start + 1) / 2" counter="$Pair">
            <set_value name="$i" exact="$Start + ($Pair - 1) * 2"/>
            <run_actions ref="Choose">
              <param name="Name" value="$List.{$i}"/>
              <param name="Value" value="$List.{$i + 1}"/>
            </run_actions>
          </do_all>
        </do_if>
      </actions>
    </library>

    <!-- Clears this save's values: everything follows the config file again -->
    <library name="Reset" purpose="run_actions">
      <actions>
        <set_value name="global.$APiratesLife_Chosen" exact="table[]"/>
        <run_actions ref="Apply"/>
        <debug_text text="'[apirateslife] settings: reset to the config file values'"/>
      </actions>
    </library>

    <library name="GetSetting" purpose="run_actions">
      <params>
        <param name="Name"/>
      </params>
      <actions>
        <do_if value="$Name == 'IntactOnEject'">
          <return value="@global.$APiratesLife_IntactOnEject"/>
        </do_if>
        <do_elseif value="$Name == 'IntactOnClaim'">
          <return value="@global.$APiratesLife_IntactOnClaim"/>
        </do_elseif>
        <do_elseif value="$Name == 'CaptureWingFullChance'">
          <return value="@global.$APiratesLife_CaptureWingFullChance"/>
        </do_elseif>
        <return value="null"/>
      </actions>
    </library>

    <library name="SetSetting" purpose="run_actions">
      <params>
        <param name="Name"/>
        <param name="Value"/>
      </params>
      <actions>
        <do_if value="$Name == 'IntactOnEject'">
          <set_value name="global.$APiratesLife_IntactOnEject" exact="$Value"/>
        </do_if>
        <do_elseif value="$Name == 'IntactOnClaim'">
          <set_value name="global.$APiratesLife_IntactOnClaim" exact="$Value"/>
        </do_elseif>
        <do_elseif value="$Name == 'CaptureWingFullChance'">
          <set_value name="global.$APiratesLife_CaptureWingFullChance" exact="$Value"/>
        </do_elseif>
      </actions>
    </library>

    <!-- The page and its Lua. $Handled counts the events handled, $Reported and $UiExtensions
         record the Lua's report since the last start or load. -->
    <cue name="Lua">
      <actions>
        <set_value name="$Handled" exact="0"/>
        <set_value name="$Reported" exact="false"/>
        <set_value name="$UiExtensions" exact="false"/>
      </actions>
      <cues>
        <cue name="UiEvent" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'APiratesLife_Settings'"/>
          </conditions>
          <actions>
            <set_value name="$Control" exact="event.param2"/>
            <set_value name="$Param" exact="event.param3"/>
            <do_if value="$Control == 'LuaLoaded'">
              <set_value name="Lua.$UiExtensions" exact="typeof $Param == datatype.list and $Param.count ge 1 and $Param.{1} == 1"/>
              <do_if value="not Lua.$Reported">
                <set_value name="Lua.$Reported" exact="true"/>
                <debug_text text="'[apirateslife] settings: %s'.[if Lua.$UiExtensions then 'settings page available (UI Extensions found)' else 'config file only (UI Extensions not found)']"/>
              </do_if>
              <!-- Seed a save that has never had settings from my defaults, once -->
              <do_if value="not global.$APiratesLife_Seeded?">
                <set_value name="global.$APiratesLife_Seeded" exact="true"/>
                <run_actions ref="ChooseList">
                  <param name="List" value="$Param"/>
                  <param name="Start" value="2"/>
                </run_actions>
                <run_actions ref="Apply"/>
                <debug_text text="'[apirateslife] settings: this save started from my defaults (%s values)'.[if typeof $Param == datatype.list and $Param.count gt 1 then ($Param.count - 1) / 2 else 0]"/>
              </do_if>
            </do_if>
            <do_elseif value="$Control == 'Reset'">
              <run_actions ref="Reset"/>
            </do_elseif>
            <do_elseif value="$Control == 'LoadDefaults'">
              <run_actions ref="ChooseList">
                <param name="List" value="$Param"/>
              </run_actions>
              <run_actions ref="Apply"/>
              <debug_text text="'[apirateslife] settings: loaded my defaults into this save'"/>
            </do_elseif>
            <do_else>
              <run_actions ref="Choose" result="$Chosen">
                <param name="Name" value="$Control"/>
                <param name="Value" value="$Param"/>
              </run_actions>
              <do_if value="$Chosen">
                <run_actions ref="Apply"/>
                <debug_text text="'[apirateslife] settings: %s set to %s in this save'.[$Control, global.$APiratesLife_Chosen.{'$' + $Control}]"/>
              </do_if>
            </do_else>
            <set_value name="Lua.$Handled" operation="add"/>
          </actions>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>
