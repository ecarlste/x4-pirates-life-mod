<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: applies the config file (md/apirateslife_config.xml) on every game start and load, so
     the patches can read global.$APiratesLife_<Name>. See docs/specs/capture-settings.md.

     The 9.x line's in-game settings page and settings profiles kept their state here too
     (global.$APiratesLife_Profile, _Modified, _InUse, _Baseline). The SWI build doesn't have them:
     those values may still be in a save, and are left alone; the config file alone decides. -->
<mdscript name="APiratesLife_Settings" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="OnLoad" instantiate="true">
      <conditions>
        <check_any>
          <event_cue_signalled cue="md.Setup.GameStart"/>
          <event_game_loaded/>
        </check_any>
      </conditions>
      <actions>
        <run_actions ref="md.APiratesLife_Config.Defaults"/>
        <debug_text text="'[apirateslife] settings: config applied (intact on claim %s, capture hold hull %s, floor hull %s, pressure step %s, cap %s, interval %s)'.[global.$APiratesLife_IntactOnClaim, global.$APiratesLife_CaptureHoldHull, global.$APiratesLife_CaptureFloorHull, global.$APiratesLife_CapturePressureStep, global.$APiratesLife_CapturePressureCap, global.$APiratesLife_CapturePressureInterval]"/>
      </actions>
    </cue>
  </cues>
</mdscript>
