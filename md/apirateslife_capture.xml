<?xml version="1.0" encoding="utf-8"?>
<!-- Capture operations: the player starts one on a ship (for now from a comm choice, our
     md/conversations.xml patch); their wingmen get aiscripts/order.apirateslife.capture.xml, which
     breaks the hull to a hold line and then only keeps the shields down. A mission shows the bail
     gates, the pilot's nerve and crew aboard, and every outcome ends the operation with its own message.
     See docs/specs/capture-operation.md.

     While an operation runs, it is listed by target in
       global.$APiratesLife_CaptureOps.{$target}
         = table[$leader, $members, $op, $lastchance, $gatestime, $gatessince, $fear, $wingdps,
                 $finisher]
     which the wingman order and the bail hook (md/apirateslife_bail.xml) read. $gatestime is the
     time the target has spent inside the bail gates so far, not counting the stretch since
     $gatessince (null while it is outside them); $fear is the pilot's fear when the operation
     started. Pressure turns them into bail pressure. $wingdps is the summed laser and turret
     damage per second of the wingmen still attacking the target (WingDps), kept current by Tick; each
     wingman's order turns it into the wing's burst, what may still land after the wing stops.
     $finisher is the one wingman that fires single shots inside that burst's margin (Finisher),
     also kept by Tick; null when no wingman has a forward gun.
     A global table, because X4 can't store script variables on a ship (only on NPCs), and AI
     scripts can read globals.

     Fear, the pressure an operation leaves when it ends without a capture (called off or
     escaped), is kept on the target's pilot, an NPC, as
       $pilot.$APiratesLife_Fear = table[$points, $time]
     the points left and when. Fear reads it decayed; the next operation on that pilot starts from
     it and takes it off the pilot, so a capture or the ship's destruction leaves none. -->
<mdscript name="APiratesLife_Capture" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <!-- Whether an operation can start on this ship: a piloted, capturable, non-capital ship that
         isn't the player's, ownerless, or already in an operation, while the player flies a ship -->
    <library name="CanStart" purpose="run_actions">
      <params>
        <param name="Target"/>
      </params>
      <actions>
        <do_if value="not @$Target.isoperational or not $Target.isclass.ship">
          <return value="false"/>
        </do_if>
        <do_if value="@global.$APiratesLife_CaptureOps.{$Target}">
          <return value="false"/>
        </do_if>
        <return value="$Target.pilot.exists and $Target.iscapturable and not $Target.iscapitalship and not $Target.isplayerowned and $Target.trueowner != faction.ownerless and @player.occupiedship.isoperational and not player.occupiedship.isclass.spacesuit"/>
      </actions>
    </library>

    <!-- Whether Target is inside the bail gates: shields under 20% (or none), hull under 75% and
         not docked, the game's own conditions for a bail check of a non-capital ship -->
    <library name="InGates" purpose="run_actions">
      <params>
        <param name="Target"/>
      </params>
      <actions>
        <return value="(not $Target.maxshield or $Target.shieldpercentage lt 20) and $Target.hullpercentage lt 75 and not $Target.assigneddock"/>
      </actions>
    </library>

    <!-- Bail pressure on Target, uncapped: the fear its pilot started the operation with, plus
         CapturePressureStep points for every 10 s its operation has had it inside the bail gates.
         0 when it has no operation. -->
    <library name="Pressure" purpose="run_actions">
      <params>
        <param name="Target"/>
      </params>
      <actions>
        <set_value name="$Op" exact="@global.$APiratesLife_CaptureOps.{$Target}"/>
        <do_if value="not $Op">
          <return value="0"/>
        </do_if>
        <set_value name="$Time" exact="$Op.$gatestime"/>
        <do_if value="$Op.$gatessince != null">
          <set_value name="$Time" exact="$Time + (player.age - $Op.$gatessince)"/>
        </do_if>
        <set_value name="$PressureStep" exact="if global.$APiratesLife_CapturePressureStep? then global.$APiratesLife_CapturePressureStep else 8"/>
        <set_value name="$Fear" exact="if $Op.$fear? then $Op.$fear else 0"/>
        <return value="$Fear + ($Time)f / 10 * $PressureStep"/>
      </actions>
    </library>

    <!-- The fear an earlier operation left on Pilot, decayed to now: the points it was left with,
         x CaptureFearDecayFactor for every CaptureFearDecayInterval seconds since, applied
         smoothly. 0 when it has none. -->
    <library name="Fear" purpose="run_actions">
      <params>
        <param name="Pilot"/>
      </params>
      <actions>
        <set_value name="$Fear" exact="@$Pilot.$APiratesLife_Fear"/>
        <do_if value="not $Fear">
          <return value="0"/>
        </do_if>
        <set_value name="$Factor" exact="if global.$APiratesLife_CaptureFearDecayFactor? then global.$APiratesLife_CaptureFearDecayFactor else 0.5"/>
        <set_value name="$Interval" exact="if global.$APiratesLife_CaptureFearDecayInterval? then global.$APiratesLife_CaptureFearDecayInterval else 300"/>
        <do_if value="$Factor le 0 or $Interval le 0">
          <return value="0"/>
        </do_if>
        <set_value name="$Intervals" exact="[(player.age - $Fear.$time)f, 0].max / $Interval"/>
        <return value="$Fear.$points * ([$Factor, 1].min ^ $Intervals)"/>
      </actions>
    </library>

    <!-- The bail pressure cap, CapturePressureCap: no check's chance goes above it with pressure -->
    <library name="PressureCap" purpose="run_actions">
      <actions>
        <return value="if global.$APiratesLife_CapturePressureCap? then global.$APiratesLife_CapturePressureCap else 80"/>
      </actions>
    </library>

    <!-- How often the pressure tick asks for a bail check, CapturePressureInterval, as a time -->
    <library name="PressureInterval" purpose="run_actions">
      <actions>
        <return value="(if global.$APiratesLife_CapturePressureInterval? then global.$APiratesLife_CapturePressureInterval else 5) * 1s"/>
      </actions>
    </library>

    <!-- The pressure tick's step: asks the game for a bail check on Target with Leader as the
         attacker, unless the pilot's cooldown ($nextcapturechance) is a short one. Returns whether
         it asked. A cooldown longer than CapturePressureInterval (vanilla's 30 s) is cut short, so
         the game evaluates the check; a shorter one (SWI's 5 s after a recent check) is left alone,
         and the tick waits for it, so hits and ticks together never roll more often than once per
         interval. "Shorter" has 0.1 s of slack: SWI sets the cooldown to player.age + 5s, and in the
         frame of that check (a + 5s) - a can come out a hair over 5 s, whenever a + 5 crosses a
         power of two. Without the slack the tick took it for a long cooldown and rolled again
         (#173). -->
    <library name="PressureTickCheck" purpose="run_actions">
      <params>
        <param name="Target"/>
        <param name="Leader"/>
      </params>
      <actions>
        <run_actions ref="PressureInterval" result="$Interval"/>
        <set_value name="$Cooldown" exact="if $Target.pilot.$nextcapturechance? then $Target.pilot.$nextcapturechance - player.age else 0s"/>
        <do_if value="$Cooldown gt 0s and $Cooldown le $Interval + 0.1s">
          <return value="false"/>
        </do_if>
        <do_if value="$Cooldown gt 0s">
          <set_value name="$Target.pilot.$nextcapturechance" exact="player.age - 1s"/>
        </do_if>
        <signal_objects object="player.galaxy" param="$Leader" param2="$Target" param3="'shouldwebail'"/>
        <return value="true"/>
      </actions>
    </library>

    <!-- The summed laser and turret damage per second (dps.lasers.all + dps.turrets.all) of the
         Members still running a capture order on Target: what the whole wing may still land after
         it stops firing. Not dps.all, which adds missiles: the order blocks them. -->
    <library name="WingDps" purpose="run_actions">
      <params>
        <param name="Target"/>
        <param name="Members"/>
      </params>
      <actions>
        <set_value name="$Dps" exact="0"/>
        <do_for_each name="$Ship" in="$Members">
          <do_if value="@$Ship.isoperational and @$Ship.order.id == 'APiratesLife_Capture' and $Ship.order.$target == $Target">
            <!-- The order keeps it on the pilot, from before it took guns out of the weapon group
                 or held its turrets' fire; until it has, the ship's own -->
            <set_value name="$Dps" exact="$Dps + (if @$Ship.pilot.$APiratesLife_Dps then $Ship.pilot.$APiratesLife_Dps else $Ship.dps.lasers.all + $Ship.dps.turrets.all)"/>
          </do_if>
        </do_for_each>
        <return value="$Dps"/>
      </actions>
    </library>

    <!-- The wingman that finishes the break inside the wing's burst margin, one shot at a time:
         Current while it is still running a capture order on Target, else the closest Member that
         is and has a forward gun (dps.lasers.all counts no turrets). Null if there is none: a wing
         of turrets only stops at the margin, and the player finishes. -->
    <library name="Finisher" purpose="run_actions">
      <params>
        <param name="Target"/>
        <param name="Members"/>
        <param name="Current"/>
      </params>
      <actions>
        <set_value name="$Finisher" exact="null"/>
        <do_if value="@$Current.isoperational and @$Current.order.id == 'APiratesLife_Capture' and $Current.order.$target == $Target and $Current.dps.lasers.all gt 0">
          <set_value name="$Finisher" exact="$Current"/>
        </do_if>
        <do_else>
          <do_for_each name="$Ship" in="$Members">
            <do_if value="@$Ship.isoperational and @$Ship.order.id == 'APiratesLife_Capture' and $Ship.order.$target == $Target and $Ship.sector == $Target.sector and $Ship.dps.lasers.all gt 0">
              <do_if value="not $Finisher or $Ship.distanceto.{$Target} lt $Finisher.distanceto.{$Target}">
                <set_value name="$Finisher" exact="$Ship"/>
              </do_if>
            </do_if>
          </do_for_each>
        </do_else>
        <return value="$Finisher"/>
      </actions>
    </library>

    <!-- Starts an operation on Target, led by the ship the player is flying. Returns whether it
         started. Every entry point (comm choice, interact menu, hotkeys) goes through here. -->
    <library name="Start" purpose="run_actions">
      <params>
        <param name="Target"/>
      </params>
      <actions>
        <run_actions ref="CanStart" result="$Ok">
          <param name="Target" value="$Target"/>
        </run_actions>
        <do_if value="$Ok">
          <signal_cue_instantly cue="Operation" param="$Target"/>
        </do_if>
        <do_else>
          <debug_text text="'[apirateslife] capture: cannot start an operation on %s'.[@$Target.knownname]"/>
        </do_else>
        <return value="$Ok"/>
      </actions>
    </library>

    <!-- One instance per operation, signalled by Start with the target -->
    <cue name="Operation" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Target" exact="event.param"/>
        <set_value name="$Name" exact="$Target.knownname"/>
        <set_value name="$Leader" exact="player.occupiedship"/>
        <set_value name="$Hold" exact="if global.$APiratesLife_CaptureHoldHull? then global.$APiratesLife_CaptureHoldHull else 75"/>
        <set_value name="$Floor" exact="if global.$APiratesLife_CaptureFloorHull? then global.$APiratesLife_CaptureFloorHull else 35"/>

        <!-- The leader's wingmen in the target's sector join. Their other orders are cancelled, as
             vanilla's squad commands do, so a queued Attack can't kill the prize afterwards; once
             the capture order ends, their default behavior (formation) resumes. -->
        <set_value name="$Members" exact="[]"/>
        <do_for_each name="$Ship" in="$Leader.subordinates">
          <do_if value="$Ship.isclass.ship and $Ship.isoperational and @$Ship.pilot.exists and $Ship.sector == $Target.sector and not $Ship.dock">
            <cancel_all_orders object="$Ship"/>
            <create_order object="$Ship" id="'APiratesLife_Capture'" immediate="true">
              <param name="target" value="$Target"/>
              <param name="holdhull" value="$Hold"/>
              <param name="floorhull" value="$Floor"/>
              <!-- Dev only: set global.$APiratesLife_CaptureDebug to 100 to log the order's decisions -->
              <param name="debugchance" value="if global.$APiratesLife_CaptureDebug? then global.$APiratesLife_CaptureDebug else 0"/>
            </create_order>
            <append_to_list name="$Members" exact="$Ship"/>
          </do_if>
        </do_for_each>
        <do_if value="not global.$APiratesLife_CaptureOps?">
          <set_value name="global.$APiratesLife_CaptureOps" exact="table[]"/>
        </do_if>
        <!-- Tables are shared by reference, so the bail hook can record $lastchance in it -->
        <run_actions ref="InGates" result="$InGates">
          <param name="Target" value="$Target"/>
        </run_actions>
        <!-- The operation starts from the pilot's fear, and takes it off the pilot: End puts back
             what's left if this one ends without a capture -->
        <run_actions ref="Fear" result="$Fear">
          <param name="Pilot" value="$Target.pilot"/>
        </run_actions>
        <remove_value name="$Target.pilot.$APiratesLife_Fear"/>
        <run_actions ref="WingDps" result="$WingDps">
          <param name="Target" value="$Target"/>
          <param name="Members" value="$Members"/>
        </run_actions>
        <set_value name="$Op" exact="table[$leader = $Leader, $members = $Members, $op = this, $lastchance = null, $gatestime = 0s, $gatessince = (if $InGates then player.age else null), $fear = $Fear, $wingdps = $WingDps, $finisher = null]"/>
        <set_value name="global.$APiratesLife_CaptureOps.{$Target}" exact="$Op"/>

        <!-- Starting a capture is the act of piracy: this one ship turns hostile to the player, as
             it would after the player's first shot. Without it, player-owned ships may not fire on
             a ship they aren't hostile to (vanilla's Attack order stands down on a "friendly
             target" too). The same boost as vanilla's "Mark as hostile" interaction
             (ui/addons/ego_detailmonitor/menu_userquestion.lua: -1, decay 1, 600 s), with its
             reason, so it reads the same. 8.00's common.xsd doesn't list markedashostile among the
             reasons, but the game knows it (game test capture_marked_as_hostile). Faction
             reputation is left to vanilla's cost for the damage done.
             With wingmen, each capture order applies it once it runs: applied here, the wingmen's
             escort behavior would see a new enemy first and queue vanilla's Attack (missiles and
             all) ahead of ours, as the game tests showed. -->
        <do_if value="not $Members.count">
          <set_relation_boost object="$Target" faction="faction.player" value="-1" decay="1" delay="600s" reason="relationchangereason.markedashostile"/>
        </do_if>

        <!-- The readout's steps: the bail gates, the pilot's nerve, and crew aboard for a ship with
             crew besides the pilot -->
        <set_value name="$CrewStart" exact="$Target.people.count"/>
        <create_mission cue="this" name="{1774100, 10}.[$Name]" description="{1774100, 11}" faction="faction.player" type="missiontype.fight" abortable="true">
          <briefing>
            <objective step="1" action="objective.custom" customaction="{1774100, 26}" object="$Target"/>
            <objective step="2" action="objective.custom" customaction="{1774100, 22}" object="$Target"/>
          </briefing>
        </create_mission>
        <do_if value="$CrewStart">
          <update_mission cue="this">
            <briefing>
              <objective step="3" action="objective.custom" customaction="{1774100, 27}" object="$Target"/>
            </briefing>
          </update_mission>
        </do_if>
        <set_value name="$Objective" exact="''"/>
        <set_value name="$Started" exact="player.age"/>
        <show_notification text="{1774100, 30}.[$Name]"/>
        <debug_text text="'[apirateslife] capture: started on %s (%s), led by %s (%s) with %s wingmen (hold %s%%, floor %s%%, fear %s)'.[$Name, $Target.idcode, $Leader.knownname, $Leader.idcode, $Members.count, $Hold, $Floor, $Fear]"/>
        <signal_cue_instantly cue="md.APiratesLife_Capture.Started" param="table[$target = $Target, $leader = $Leader, $members = $Members]"/>
      </actions>
      <cues>
        <cue name="Tick" checkinterval="1s" instantiate="true">
          <actions>
            <set_value name="$Outcome" exact="null"/>
            <do_if value="not $Target.exists or not $Target.isoperational">
              <set_value name="$Outcome" exact="'destroyed'"/>
            </do_if>
            <do_elseif value="$Target.isplayerowned">
              <set_value name="$Outcome" exact="'captured'"/>
            </do_elseif>
            <do_elseif value="$Target.trueowner == faction.ownerless">
              <set_value name="$Outcome" exact="'abandoned'"/>
            </do_elseif>
            <do_elseif value="not $Leader.isoperational">
              <set_value name="$Outcome" exact="'calledoff'"/>
            </do_elseif>
            <do_else>
              <!-- Escaped: nobody in the operation within 15 km for 30 s, so a jump through a gate
                   ahead of the wing doesn't end it at once. The timer only runs once someone has
                   been within 15 km: the player can hail from farther away, and the wing still has
                   to fly in (a 6-wingman operation once "escaped" 30 s after the hail). If nobody
                   gets close within 5 minutes, the target got away. -->
              <set_value name="$Near" exact="$Leader.sector == $Target.sector and $Leader.distanceto.{$Target} lt 15km"/>
              <do_for_each name="$Ship" in="$Members">
                <do_if value="@$Ship.isoperational and $Ship.sector == $Target.sector and $Ship.distanceto.{$Target} lt 15km">
                  <set_value name="$Near" exact="true"/>
                </do_if>
              </do_for_each>
              <do_if value="$Near">
                <set_value name="$Engaged" exact="true"/>
                <remove_value name="$FarSince"/>
              </do_if>
              <do_elseif value="not $Engaged?">
                <do_if value="player.age - $Started ge 300s">
                  <set_value name="$Outcome" exact="'escaped'"/>
                </do_if>
              </do_elseif>
              <do_elseif value="not $FarSince?">
                <set_value name="$FarSince" exact="player.age"/>
              </do_elseif>
              <do_elseif value="player.age - $FarSince ge 30s">
                <set_value name="$Outcome" exact="'escaped'"/>
              </do_elseif>
            </do_else>

            <do_if value="$Outcome">
              <signal_cue_instantly cue="End" param="$Outcome"/>
            </do_if>
            <do_else>
              <!-- The wing's laser damage, as wingmen die or leave the operation -->
              <run_actions ref="WingDps" result="$WingDps">
                <param name="Target" value="$Target"/>
                <param name="Members" value="$Members"/>
              </run_actions>
              <set_value name="$Op.$wingdps" exact="$WingDps"/>
              <run_actions ref="Finisher" result="$Finisher">
                <param name="Target" value="$Target"/>
                <param name="Members" value="$Members"/>
                <param name="Current" value="$Op.$finisher"/>
              </run_actions>
              <debug_text text="'[apirateslife] capture: finisher on %s is now %s (was %s)'.[$Target.knownname, @$Finisher.knownname, @$Op.$finisher.knownname]" chance="if $Finisher != $Op.$finisher and global.$APiratesLife_CaptureDebug? then global.$APiratesLife_CaptureDebug else 0"/>
              <set_value name="$Op.$finisher" exact="$Finisher"/>
              <!-- Bail pressure: count the time inside the bail gates -->
              <run_actions ref="InGates" result="$InGates">
                <param name="Target" value="$Target"/>
              </run_actions>
              <do_if value="$InGates and $Op.$gatessince == null">
                <set_value name="$Op.$gatessince" exact="player.age"/>
              </do_if>
              <do_elseif value="not $InGates and $Op.$gatessince != null">
                <set_value name="$Op.$gatestime" exact="$Op.$gatestime + (player.age - $Op.$gatessince)"/>
                <set_value name="$Op.$gatessince" exact="null"/>
              </do_elseif>

              <!-- The pressure tick: while the player leads the operation within about 10 km and
                   the target is inside the gates, ask for a bail check every
                   CapturePressureInterval, so checks don't wait for hits (a wing holding the
                   shields down barely hits). It goes through the game's own bail path, as an
                   attacked ship's AI asks for one (aiscripts/interrupt.attacked.xml).
                   PressureTickCheck says how it treats the pilot's cooldown. -->
              <do_if value="$InGates and @$Target.pilot.exists and player.occupiedship == $Leader and $Leader.sector == $Target.sector and $Leader.distanceto.{$Target} lt 10km and (not $NextPressureTick? or player.age ge $NextPressureTick)">
                <run_actions ref="PressureTickCheck" result="$Asked">
                  <param name="Target" value="$Target"/>
                  <param name="Leader" value="$Leader"/>
                </run_actions>
                <do_if value="$Asked">
                  <run_actions ref="PressureInterval" result="$Interval"/>
                  <set_value name="$NextPressureTick" exact="player.age + $Interval"/>
                </do_if>
              </do_if>

              <!-- The readout: the bail gates, then the pilot's nerve, then crew aboard once crew
                   start to leave. Nothing in it assumes a cooldown length, so it reads the same
                   with SWI's 5 s and vanilla's 30 s. Only updated on change. -->
              <do_if value="$Target.maxshield and $Target.shieldpercentage ge 20">
                <set_value name="$Step" exact="1"/>
                <set_value name="$Text" exact="{1774100, 20}"/>
                <set_value name="$Progress" exact="[[(100 - $Target.shieldpercentage)i, 0].max, 80].min"/>
                <set_value name="$Max" exact="80"/>
              </do_if>
              <!-- Also while docked, the gate that hull and shields don't show -->
              <do_elseif value="not $InGates">
                <set_value name="$Step" exact="1"/>
                <set_value name="$Text" exact="{1774100, 21}"/>
                <set_value name="$Progress" exact="[[(100 - $Target.hullpercentage)i, 0].max, 25].min"/>
                <set_value name="$Max" exact="25"/>
              </do_elseif>
              <do_else>
                <!-- The last check's chance, rounded for display only -->
                <set_value name="$Chance" exact="if $Op.$lastchance != null then (($Op.$lastchance)f + 0.5)i else null"/>
                <set_value name="$Crew" exact="$Target.people.count"/>
                <do_if value="$CrewStart and $Crew lt $CrewStart">
                  <set_value name="$Step" exact="3"/>
                  <set_value name="$Text" exact="if $Chance != null then {1774100, 25}.[$Crew, $CrewStart, $Chance] else {1774100, 24}.[$Crew, $CrewStart]"/>
                  <set_value name="$Progress" exact="$Crew"/>
                  <set_value name="$Max" exact="$CrewStart"/>
                </do_if>
                <do_else>
                  <!-- The nerve bar empties as pressure builds toward the cap -->
                  <run_actions ref="Pressure" result="$Pressure">
                    <param name="Target" value="$Target"/>
                  </run_actions>
                  <run_actions ref="PressureCap" result="$Cap"/>
                  <set_value name="$Cap" exact="[$Cap, 1].max"/>
                  <set_value name="$Step" exact="2"/>
                  <set_value name="$Text" exact="if $Chance != null then {1774100, 23}.[$Chance] else {1774100, 22}"/>
                  <set_value name="$Progress" exact="[($Cap - ($Pressure)f)i, 0].max"/>
                  <set_value name="$Max" exact="$Cap"/>
                </do_else>
              </do_else>
              <set_value name="$Key" exact="'%s|%s|%s'.[$Step, $Text, $Progress]"/>
              <do_if value="$Key != $Objective">
                <set_value name="$Objective" exact="$Key"/>
                <set_objective cue="Operation" step="$Step" action="objective.custom" customaction="$Text" object="$Target">
                  <progress text="$Text" progress="$Progress" max="$Max"/>
                </set_objective>
              </do_if>
            </do_else>
          </actions>
        </cue>

        <cue name="Aborted">
          <conditions>
            <event_mission_aborted cue="Operation"/>
          </conditions>
          <actions>
            <signal_cue_instantly cue="End" param="'calledoff'"/>
          </actions>
        </cue>

        <!-- Signalled once with the outcome: abandoned, captured, destroyed, escaped or calledoff -->
        <cue name="End">
          <conditions>
            <event_cue_signalled/>
          </conditions>
          <actions>
            <set_value name="$Outcome" exact="event.param"/>
            <!-- Called off or escaped: the pilot keeps the pressure left as fear, for a later
                 operation. Read before the operation's state goes. -->
            <set_value name="$FearLeft" exact="0"/>
            <do_if value="($Outcome == 'calledoff' or $Outcome == 'escaped') and @$Target.pilot.exists">
              <run_actions ref="Pressure" result="$FearLeft">
                <param name="Target" value="$Target"/>
              </run_actions>
              <do_if value="$FearLeft gt 0">
                <set_value name="$Target.pilot.$APiratesLife_Fear" exact="table[$points = $FearLeft, $time = player.age]"/>
              </do_if>
            </do_if>
            <!-- Wingmen's orders end once the operation is no longer listed; the signal stops one
                 that is in the middle of an attack at once -->
            <remove_value name="global.$APiratesLife_CaptureOps.{$Target}"/>
            <!-- Called off or escaped: take back the hostility we added, so the player's escorts
                 don't hunt the ship down afterwards. Damage already done still costs reputation. -->
            <do_if value="($Outcome == 'calledoff' or $Outcome == 'escaped') and @$Target.isoperational">
              <reset_relation_boost object="$Target" faction="faction.player"/>
            </do_if>
            <do_for_each name="$Ship" in="$Members">
              <do_if value="$Ship.exists">
                <signal_objects object="$Ship" param="'apirateslife_capture_end'" param2="$Target"/>
              </do_if>
            </do_for_each>
            <do_if value="$Outcome == 'abandoned'">
              <remove_mission cue="Operation" type="completed"/>
              <show_notification text="{1774100, 31}.[$Name]"/>
            </do_if>
            <do_elseif value="$Outcome == 'captured'">
              <remove_mission cue="Operation" type="completed"/>
              <show_notification text="{1774100, 32}.[$Name]"/>
            </do_elseif>
            <do_elseif value="$Outcome == 'destroyed'">
              <remove_mission cue="Operation" type="failed"/>
              <show_notification text="{1774100, 33}.[$Name]"/>
            </do_elseif>
            <do_elseif value="$Outcome == 'escaped'">
              <remove_mission cue="Operation" type="failed"/>
              <show_notification text="{1774100, 34}.[$Name]"/>
            </do_elseif>
            <do_else>
              <remove_mission cue="Operation" type="aborted"/>
              <show_notification text="{1774100, 35}.[$Name]"/>
            </do_else>
            <debug_text text="'[apirateslife] capture: ended on %s (%s): %s (fear left %s)'.[$Name, @$Target.idcode, $Outcome, $FearLeft]"/>
            <signal_cue_instantly cue="md.APiratesLife_Capture.Ended" param="table[$target = $Target, $outcome = $Outcome]"/>
            <cancel_cue cue="Operation"/>
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- Signalled whenever an operation starts, with table[$target, $leader, $members]. For the
         capture metrics (md/apirateslife_metrics.xml) and future features. -->
    <cue name="Started" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
    </cue>

    <!-- Signalled whenever an operation ends, with table[$target, $outcome]. For tests and future
         features (notoriety, raid reports). -->
    <cue name="Ended" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
    </cue>

    <!-- The comm choice from our md/conversations.xml patch -->
    <cue name="CommChoice" instantiate="true">
      <conditions>
        <event_conversation_next_section section="g_apirateslife_capture"/>
      </conditions>
      <actions>
        <run_actions ref="Start" result="$Started">
          <param name="Target" value="event.object.controlled"/>
        </run_actions>
        <do_if value="$Started">
          <add_npc_line line="5036" comment="(refusal to surrender - finds it funny)"/>
        </do_if>
      </actions>
    </cue>
  </cues>
</mdscript>
