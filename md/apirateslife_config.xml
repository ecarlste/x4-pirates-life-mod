<?xml version="1.0" encoding="utf-8"?>
<!--
  A Pirate's Life: default settings
  =================================

  Edit the values below to change the mod's behavior (1 = on, 0 = off). Changes apply the next
  time you start or load a game. Note: updating the mod replaces this file, so edits are lost on
  update.

  Developers: md/apirateslife_settings.xml (its OnLoad cue) applies this file on every start and
  load, and is its only caller; the config_applied_on_start game test covers it. Keep that script.

  Developers: deploy.sh and deploy.ps1 can override these values in the deployed copy without
  editing this file; see "Everyday commands" in the README. (No double hyphens in this comment:
  XML forbids them, and X4 would then skip this whole file.)
-->
<mdscript name="APiratesLife_Config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <library name="Defaults" purpose="run_actions">
      <actions>
        <!-- ===== Captures ===== -->

        <!-- Intact when marines claim: claiming an abandoned ship with marines doesn't damage the
             hull or destroy equipment. 0 = vanilla behavior. -->
        <set_value name="global.$APiratesLife_IntactOnClaim" exact="1"/>

        <!-- ===== Tuning ===== -->

        <!-- Capture operations: wingmen attack the target at full strength until its hull is below
             this percentage, then only knock its shields down and stop once they're gone. 75 is
             vanilla's bail gate (a bail check needs hull below 75%); higher values make no sense. -->
        <set_value name="global.$APiratesLife_CaptureHoldHull" exact="75"/>

        <!-- Capture operations: nobody in the operation fires once the target's hull is at or below
             this percentage. -->
        <set_value name="global.$APiratesLife_CaptureFloorHull" exact="35"/>
      </actions>
    </library>
  </cues>
</mdscript>
