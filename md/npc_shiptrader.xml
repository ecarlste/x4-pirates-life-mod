<?xml version="1.0" encoding="utf-8"?>
<!-- Diff patch for vanilla md/npc_shiptrader.xml: adds "Hand over booty" to the ship trader's own
     conversation at a pirate group's wharf or shipyard. Ship traders don't use DefaultComm, where
     md/conversations.xml adds it for the other station staff. See docs/specs/booty.md. -->
<diff>
  <!-- "bottom_left" is free there: the ship trader uses top_left (buy ships), left (upgrade a ship),
       top_right (directions), right (how to find them) and bottom_right (goodbye). Handled by
       md.APiratesLife_Booty.Choice. -->
  <add sel="//cue[@name='DefaultComm']//add_player_choice_return[@comment='Goodbye']" pos="before">
    <do_if value="not event.object.isplayerowned">
      <run_actions ref="md.APiratesLife_Booty.StationOf" result="$apirateslife_bootystation">
        <param name="Npc" value="event.object"/>
      </run_actions>
      <do_if value="$apirateslife_bootystation">
        <add_player_choice_sub text="{1774101, 1}" section="g_apirateslife_booty" position="bottom_left" choiceparam="[$apirateslife_bootystation, 1]"/>
      </do_if>
      <remove_value name="$apirateslife_bootystation"/>
    </do_if>
  </add>
</diff>
