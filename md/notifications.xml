<?xml version="1.0" encoding="utf-8"?>
<!-- Diff patch for vanilla md/notifications.xml: routes every bail check and bail through
     md/apirateslife_bail.xml. Inserts only; vanilla's logic is left intact. See docs/specs/bail-hook.md. -->
<diff>
  <!-- Let our code adjust the final eject chance just before vanilla rolls it -->
  <add sel="//cue[@name='PlayerOwnedShipAttacks']//do_if[@chance='if not $testcheat? then $ejectchance else 100']" pos="before">
    <run_actions ref="md.APiratesLife_Bail.AdjustEjectChance" result="$ejectchance">
      <param name="EjectChance" value="$ejectchance"/>
      <param name="Attacker" value="$attacker"/>
      <param name="Target" value="$target"/>
    </run_actions>
  </add>

  <!-- When the pilot bails, vanilla drops the hull to about (100 - pilot skill)% and the pilot
       sabotages up to (pilot skill / 10) weapons, turrets and shield generators. We stop both so a
       captured ship arrives as the player left it. See docs/specs/claim-no-damage.md.
       $damageminpercent must be 100, NOT 0: vanilla sets the hull to min(current, value), so 100
       keeps the current hull, while 0 takes vanilla's do_else, which DESTROYS the ship (meant for
       a perfect-skill pilot scuttling it). -->
  <!-- Both only apply while the "intact on eject" setting is on (missing counts as on);
       see md/apirateslife_settings.xml -->
  <add sel="//cue[@name='PlayerOwnedShipAttacks']//set_value[@name='$damageminpercent']" pos="after">
    <do_if value="not (global.$APiratesLife_IntactOnEject? and global.$APiratesLife_IntactOnEject == 0)">
      <set_value name="$damageminpercent" exact="100"/>
    </do_if>
  </add>
  <add sel="//cue[@name='PlayerOwnedShipAttacks']//set_value[@name='$scuttle']" pos="after">
    <do_if value="not (global.$APiratesLife_IntactOnEject? and global.$APiratesLife_IntactOnEject == 0)">
      <debug_text text="'[apirateslife] pilot bail: %s keeps its hull and equipment (vanilla sabotage: %s, pilot skill %s)'.[@$target.knownname, $scuttle, $targetpilotskill]"/>
      <set_value name="$scuttle" exact="false"/>
    </do_if>
    <do_else>
      <debug_text text="'[apirateslife] pilot bail: %s takes vanilla damage (intact on eject is off)'.[@$target.knownname]"/>
    </do_else>
  </add>

  <!-- Announce every bail (crew and pilot) before vanilla discards the crew count -->
  <add sel="//cue[@name='PlayerOwnedShipAttacks']//do_if[@value='$eject?']/remove_value[@name='$numcrewbailing']" pos="before">
    <signal_cue_instantly cue="md.APiratesLife_Bail.Bailed" param="table[$attacker = $attacker, $target = $target, $crew = $numcrewbailing, $pilot = $pilotbail?]"/>
  </add>
</diff>
